{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ico %}

{% block title %}{{ 'trakt.page.title'|trans }}{% endblock %}
{% block page_title %}Trakt{% endblock %}

{% block body %}
<style>
  /* Cards, grid and badges all come from decouverte/_detail_modal.html.twig
     (.tmdb-results-grid / .media-card / .vote-badge / .lib-badge / .hover-info),
     so this page looks exactly like Decouverte. Only page furniture lives here. */
  .tk-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-bottom: 1rem; }
  .tk-count { font-size: .78rem; color: var(--tblr-secondary); }
  .tk-connect code {
    font-size: 1.4rem; font-weight: 700; letter-spacing: .18em;
    padding: .2rem .6rem; border-radius: .3rem;
    background: var(--tblr-bg-surface-secondary); color: var(--tblr-body-color);
  }
  .tmdb-results-grid .media-card .h-actions .btn { font-size: .68rem; padding: .15rem .45rem; }
  /* Reuses the shared .lib-badge component; only the corner and colour differ,
     since quality-badge and lib-badge already occupy the top left. */
  .tmdb-results-grid .media-card .lib-badge.tk-watched {
    left: auto; right: .4rem; background: rgba(34,197,94,.92);
  }
</style>

<div class="container-xl">
  {% if error %}
    <div class="alert alert-danger">{{ 'trakt.error.unavailable'|trans }}</div>
  {% endif %}

  {% if not can_write %}
    {# Reading a public profile needs only the client id. Removing an entry is a
       write, and Trakt answers 401 to those without OAuth. The device flow needs
       no callback URL, which is why it is used here. #}
    <div class="alert alert-warning tk-connect" id="tk-connect-box">
      <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="flex-fill">
          <strong>{{ 'trakt.connect.title'|trans }}</strong>
          <div class="text-secondary" id="tk-connect-hint">
            {{ can_connect ? 'trakt.connect.ready'|trans : 'trakt.connect.need_secret'|trans }}
          </div>
        </div>
        {% if can_connect %}
          <button type="button" class="btn btn-sm btn-primary" id="tk-connect">{{ 'trakt.connect.action'|trans }}</button>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <div class="tk-toolbar">
    <div class="btn-group btn-group-sm" role="group">
      <button type="button" class="btn btn-outline-secondary active" data-tk-filter="all">{{ 'trakt.filter.all'|trans }}</button>
      <button type="button" class="btn btn-outline-secondary" data-tk-filter="movie">{{ 'trakt.filter.movies'|trans({count: movies}) }}</button>
      <button type="button" class="btn btn-outline-secondary" data-tk-filter="tv">{{ 'trakt.filter.shows'|trans({count: shows}) }}</button>
    </div>
    <button type="button" class="btn btn-sm btn-outline-primary" id="tk-import">{{ 'trakt.action.import_all'|trans }}</button>
    {% if can_write %}
      <button type="button" class="btn btn-sm btn-outline-secondary" id="tk-disconnect">{{ 'trakt.connect.disconnect'|trans }}</button>
    {% endif %}
    <span class="tk-count" id="tk-count"></span>
  </div>

{% include 'decouverte/_detail_modal.html.twig' %}

  <div class="tmdb-results-grid" id="tk-grid">
    {% for item in items %}
    {# Same structure as the card macro in decouverte/index.html.twig, so the
       theme is shared rather than imitated. Trakt-only facts (your rating,
       watched state, Trakt community score) ride in the hover line. #}
    <div class="media-card"
         data-tmdb-id="{{ item.tmdb_id }}"
         data-tmdb-type="{{ item.type }}"
         data-tmdb-title="{{ item.title|e('html_attr') }}"
         data-tmdb-year="{{ item.year ?: '' }}">
      <div class="no-poster" data-tk-poster>
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 4v16l13 -8z"/></svg>
      </div>
      <span class="quality-badge {{ item.type }}">{{ item.type == 'movie' ? 'decouverte.modal.type_film'|trans : 'decouverte.modal.type_series'|trans }}</span>
      {% if item.in_local %}
        <span class="lib-badge" style="background:#6366f1;">{{ 'trakt.badge.in_watchlist_short'|trans }}</span>
      {% endif %}
      <span class="lib-badge tk-watched" data-tk-watched style="display:none;"></span>
      <span class="vote-badge" data-tk-vote style="display:none;"></span>
      <div class="card-overlay">
        <div class="card-title-text" title="{{ item.title }}">{{ item.title }}</div>
        <div class="card-year">{{ item.year ?: '' }}</div>
      </div>
      <div class="hover-info">
        <div class="h-title">{{ item.title }}</div>
        <div class="h-year">
          {{ item.year ?: '' }}
          {% if item.community_rating %} · {{ ico.icon('star-filled', '', 14) }} {{ item.community_rating }} Trakt{% endif %}
          <span data-tk-marks></span>
        </div>
        <div class="h-actions">
          <button type="button" class="btn btn-primary btn-sm" data-tk-request>{{ 'trakt.action.request'|trans }}</button>
          <button type="button" class="btn btn-sm btn-outline-warning" data-tk-watchlist>{{ 'trakt.action.watchlist'|trans }}</button>
          {% if can_write %}
            <button type="button" class="btn btn-sm btn-outline-danger" data-tk-remove
                    title="{{ 'trakt.action.remove_title'|trans }}">{{ 'trakt.action.remove'|trans }}</button>
          {% endif %}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>

  {% if items is empty and not error %}
    <div class="empty">
      <p class="empty-title">{{ 'trakt.empty.title'|trans }}</p>
      <p class="empty-subtitle text-secondary">{{ 'trakt.empty.subtitle'|trans }}</p>
    </div>
  {% endif %}
</div>

<script>
(function () {
  var BASE = {{ path('trakt_index')|json_encode|raw }};
  var STAR_ICON = {{ ico.icon('star-filled', '', 14)|json_encode|raw }};
  var MINE_LABEL = {{ 'trakt.mark.mine'|trans|json_encode|raw }};
  var SEEN_LABEL = {{ 'trakt.mark.seen'|trans|json_encode|raw }};
  var grid = document.getElementById('tk-grid');
  if (!grid) return;
  var cards = Array.from(grid.querySelectorAll('.media-card'));
  var countEl = document.getElementById('tk-count');

  function updateCount() {
    var shown = cards.filter(function (c) { return c.style.display !== 'none'; }).length;
    if (countEl) countEl.textContent = {{ 'trakt.count'|trans({count: '__N__'})|json_encode|raw }}.replace('__N__', shown);
  }

  // ── Filter ────────────────────────────────────────────────────────────
  document.querySelectorAll('[data-tk-filter]').forEach(function (btn) {
    btn.onclick = function () {
      var want = btn.dataset.tkFilter;
      document.querySelectorAll('[data-tk-filter]').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      cards.forEach(function (c) {
        c.style.display = (want === 'all' || c.dataset.tmdbType === want) ? '' : 'none';
      });
      updateCount();
    };
  });
  updateCount();

  // ── Poster hydration ──────────────────────────────────────────────────
  // Six at a time so a cold TMDb cache does not open 57 sockets at once.
  var queue = cards.slice();
  function pump() {
    var card = queue.shift();
    if (!card) return;
    fetch(BASE + '/meta/' + card.dataset.tmdbType + '/' + card.dataset.tmdbId)
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d) return;
        if (d.poster) {
          var img = document.createElement('img');
          img.src = d.poster;
          img.alt = card.dataset.tmdbTitle;
          img.loading = 'lazy';
          var ph = card.querySelector('[data-tk-poster]');
          if (ph) ph.replaceWith(img);
        }
        if (d.vote) {
          var slot = card.querySelector('[data-tk-vote]');
          if (slot) {
            slot.className = 'vote-badge ' + (d.vote >= 7 ? 'good' : (d.vote >= 5 ? 'mid' : 'bad'));
            slot.innerHTML = STAR_ICON + ' ' + d.vote;
            slot.style.display = '';
          }
        }
      })
      .catch(function () {})
      .finally(pump);
  }
  for (var i = 0; i < 6; i++) pump();

  // ── Rating / watched marks ────────────────────────────────────────────
  fetch({{ path('trakt_marks')|json_encode|raw }})
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (d) {
      if (!d) return;
      cards.forEach(function (card) {
        var key = card.dataset.tmdbType + ':' + card.dataset.tmdbId;
        var rating = d.ratings && d.ratings[key];
        var watched = d.watched && d.watched[key];
        var slot = card.querySelector('[data-tk-marks]');
        if (!slot) return;
        var bits = [];
        if (rating && rating.rating) bits.push(STAR_ICON + ' ' + rating.rating + ' ' + MINE_LABEL);
        if (bits.length) slot.innerHTML = ' · ' + bits.join(' · ');

        // Already-watched marker. Trakt holds the authoritative history here
        // because Infuse scrobbles to it, so this covers anything watched
        // anywhere, not just what Jellyfin saw.
        if (watched && watched.plays) {
          var wb = card.querySelector('[data-tk-watched]');
          if (wb) {
            wb.textContent = SEEN_LABEL + (watched.plays > 1 ? ' x' + watched.plays : '');
            if (watched.last_watched_at) {
              wb.title = SEEN_LABEL + ' ' + String(watched.last_watched_at).slice(0, 10);
            }
            wb.style.display = '';
          }
        }
      });
    })
    .catch(function () {});

  // ── Actions ───────────────────────────────────────────────────────────
  function post(url, body) {
    return fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body || {}),
    }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, data: j }; }); });
  }

  function flash(btn, label, cls) {
    btn.classList.remove('btn-outline-primary', 'btn-outline-secondary');
    btn.classList.add(cls);
    btn.textContent = label;
    btn.disabled = true;
  }

  grid.addEventListener('click', function (e) {
    var card = e.target.closest('.media-card');
    if (!card) return;
    var payload = {
      tmdb_id: parseInt(card.dataset.tmdbId, 10),
      type: card.dataset.tmdbType,
      title: card.dataset.tmdbTitle,
      year: card.dataset.tmdbYear ? parseInt(card.dataset.tmdbYear, 10) : null,
    };

    var reqBtn = e.target.closest('[data-tk-request]');
    if (reqBtn) {
      reqBtn.disabled = true;
      post({{ path('trakt_request')|json_encode|raw }}, payload).then(function (res) {
        if (res.ok) {
          flash(reqBtn, {{ 'trakt.action.requested'|trans|json_encode|raw }}, 'btn-success');
        } else {
          reqBtn.disabled = false;
          reqBtn.title = (res.data && res.data.error) || '';
          reqBtn.classList.add('btn-outline-danger');
        }
      });
      return;
    }

    var wlBtn = e.target.closest('[data-tk-watchlist]');
    if (wlBtn) {
      wlBtn.disabled = true;
      post({{ path('trakt_watchlist_add')|json_encode|raw }}, payload).then(function (res) {
        if (res.ok) {
          flash(wlBtn, {{ 'trakt.action.added'|trans|json_encode|raw }}, 'btn-success');
        } else {
          wlBtn.disabled = false;
          wlBtn.classList.add('btn-outline-danger');
        }
      });
    }
  });

{% if can_write %}
  // Contribute a "remove from Trakt" button to the modal's action column.
  window.PrismarrDetail = window.PrismarrDetail || {};
  window.PrismarrDetail.extraActions = function (d) {
    return ['<button type="button" class="btn btn-outline-danger" data-tk-modal-remove'
      + ' data-tmdb-id="' + d.id + '" data-type="' + d.type + '">'
      + {{ 'trakt.action.remove_modal'|trans|json_encode|raw }} + '</button>'];
  };

  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-tk-modal-remove]');
    if (!btn) return;
    var id = btn.dataset.tmdbId;
    var type = btn.dataset.type;
    var card = grid.querySelector('.media-card[data-tmdb-id="' + id + '"][data-tmdb-type="' + type + '"]');
    var name = card ? card.dataset.tmdbTitle : '';
    if (!window.confirm({{ 'trakt.action.remove_confirm'|trans({title: '__T__'})|json_encode|raw }}.replace('__T__', name))) return;

    btn.disabled = true;
    post({{ path('trakt_remove')|json_encode|raw }}, { tmdb_id: parseInt(id, 10), type: type })
      .then(function (res) {
        if (!res.ok) { btn.disabled = false; btn.title = (res.data && res.data.error) || ''; return; }
        if (card) {
          card.remove();
          cards = cards.filter(function (c) { return c !== card; });
          updateCount();
        }
        if (window.PrismarrDetail.close) window.PrismarrDetail.close();
      });
  });
{% endif %}

  // ── Remove from Trakt ─────────────────────────────────────────────────
  // A real write against the Trakt account, so it asks first.
  grid.addEventListener('click', function (e) {
    var rmBtn = e.target.closest('[data-tk-remove]');
    if (!rmBtn) return;
    var card = rmBtn.closest('.media-card');
    if (!card) return;
    if (!window.confirm({{ 'trakt.action.remove_confirm'|trans({title: '__T__'})|json_encode|raw }}
        .replace('__T__', card.dataset.tmdbTitle))) return;

    rmBtn.disabled = true;
    post({{ path('trakt_remove')|json_encode|raw }}, {
      tmdb_id: parseInt(card.dataset.tmdbId, 10),
      type: card.dataset.tmdbType,
    }).then(function (res) {
      if (res.ok) {
        card.remove();
        cards = cards.filter(function (c) { return c !== card; });
        updateCount();
      } else {
        rmBtn.disabled = false;
        rmBtn.title = (res.data && res.data.error) || '';
      }
    });
  });

  // ── Connect to Trakt (OAuth device flow) ──────────────────────────────
  var connectBtn = document.getElementById('tk-connect');
  if (connectBtn) {
    connectBtn.onclick = function () {
      connectBtn.disabled = true;
      var hint = document.getElementById('tk-connect-hint');
      post({{ path('trakt_connect')|json_encode|raw }}, {}).then(function (res) {
        if (!res.ok || !res.data || !res.data.user_code) {
          connectBtn.disabled = false;
          if (hint) hint.textContent = (res.data && res.data.error) || '';
          return;
        }
        var d = res.data;
        if (hint) {
          hint.innerHTML = '';
          var line = document.createElement('div');
          line.textContent = {{ 'trakt.connect.instructions'|trans|json_encode|raw }} + ' ';
          var link = document.createElement('a');
          link.href = d.verification_url;
          link.target = '_blank';
          link.rel = 'noopener';
          link.textContent = d.verification_url;
          var code = document.createElement('code');
          code.textContent = d.user_code;
          line.appendChild(link);
          hint.appendChild(line);
          hint.appendChild(code);
        }
        connectBtn.textContent = {{ 'trakt.connect.waiting'|trans|json_encode|raw }};

        var everyMs = Math.max(2, d.interval || 5) * 1000;
        var deadline = Date.now() + ((d.expires_in || 600) * 1000);
        (function tick() {
          if (Date.now() > deadline) {
            connectBtn.disabled = false;
            connectBtn.textContent = {{ 'trakt.connect.action'|trans|json_encode|raw }};
            if (hint) hint.textContent = {{ 'trakt.connect.expired'|trans|json_encode|raw }};
            return;
          }
          post({{ path('trakt_connect_poll')|json_encode|raw }}, {}).then(function (r) {
            var st = r.data && r.data.status;
            if (st === 'ok') { window.location.reload(); return; }
            if (st === 'slow_down') { everyMs += 1000; }
            if (st === 'expired' || st === 'denied' || st === 'none' || st === 'error') {
              connectBtn.disabled = false;
              connectBtn.textContent = {{ 'trakt.connect.action'|trans|json_encode|raw }};
              if (hint) hint.textContent = {{ 'trakt.connect.expired'|trans|json_encode|raw }};
              return;
            }
            setTimeout(tick, everyMs);
          });
        })();
      });
    };
  }

  var disconnectBtn = document.getElementById('tk-disconnect');
  if (disconnectBtn) {
    disconnectBtn.onclick = function () {
      disconnectBtn.disabled = true;
      post({{ path('trakt_disconnect')|json_encode|raw }}, {}).then(function () { window.location.reload(); });
    };
  }

  // ── Import all ────────────────────────────────────────────────────────
  var importBtn = document.getElementById('tk-import');
  if (importBtn) {
    importBtn.onclick = function () {
      importBtn.disabled = true;
      importBtn.textContent = {{ 'trakt.action.importing'|trans|json_encode|raw }};
      post({{ path('trakt_import')|json_encode|raw }}, {}).then(function (res) {
        if (res.ok && res.data) {
          importBtn.classList.remove('btn-outline-primary');
          importBtn.classList.add('btn-success');
          importBtn.textContent = {{ 'trakt.action.imported'|trans({count: '__N__'})|json_encode|raw }}
            .replace('__N__', res.data.added);
        } else {
          importBtn.disabled = false;
          importBtn.classList.add('btn-outline-danger');
          importBtn.textContent = {{ 'trakt.action.import_all'|trans|json_encode|raw }};
        }
      });
    };
  }
})();
</script>
{% endblock %}
