{# The Lists tab. Was the standalone /lists page until the tabbed merge.
   Its toolbar id is #dv-tabs, which predates and is unrelated to the shell's
   #dsc-tabs tab bar.

   The detail modal is NOT included here: the shell includes it once for all
   three tabs. #}
{% import '_icons.html.twig' as ico %}

<div data-dsc-pane="lists">
<style>
  /* Cards and badges come from decouverte/_detail_modal.html.twig
     (.media-card / .vote-badge / .lib-badge), so this page looks exactly like
     Decouverte and Trakt. Only page furniture and the row layout live here. */
  .dv-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-bottom: 1rem; }
  .dv-cap-note { font-size: .75rem; color: var(--tblr-secondary); }
  .dv-row-title { color: inherit; text-decoration: none; }
  .dv-row-title:hover { color: var(--tblr-primary); text-decoration: underline; }

  /* Copied from decouverte/index.html.twig: this page does not load that
     page's stylesheet, so each list row needs its own copy to look identical
     to a Decouverte carousel. */
  .tmdb-section { margin-bottom: 1.75rem; }
  .tmdb-section-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 0.5rem; padding: 0 0.25rem;
  }
  .tmdb-section-header h3 {
    margin: 0; font-size: 1rem; font-weight: 600;
    color: var(--tblr-body-color);
  }
  .tmdb-section-header h3 .count {
    font-size: 0.75rem; color: var(--tblr-secondary); font-weight: 400;
    margin-left: 0.4rem;
  }
  .tmdb-section-actions { display: flex; gap: 0.25rem; }
  .tmdb-scroll-btn {
    width: 28px; height: 28px; border-radius: 50%;
    border: 1px solid var(--tblr-border-color);
    background: var(--tblr-bg-surface); color: var(--tblr-body-color);
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer; transition: all 0.15s;
  }
  .tmdb-scroll-btn:hover { background: var(--tblr-primary); color: #fff; border-color: var(--tblr-primary); }

  .tmdb-row {
    display: flex; gap: 0.75rem; overflow-x: auto; scroll-behavior: smooth;
    padding: 0.25rem 0.25rem 0.75rem; scrollbar-width: thin;
  }
  .tmdb-row::-webkit-scrollbar { height: 6px; }
  .tmdb-row::-webkit-scrollbar-thumb { background: var(--tblr-border-color); border-radius: 3px; }

  /* Sized like .media-card[data-tmdb-id] in _detail_modal.html.twig so a row
     below the fold neither shifts nor leaves a gap once its real cards land. */
  .dv-skeleton-card {
    flex: 0 0 150px; width: 150px; aspect-ratio: 2/3;
    border-radius: .5rem;
    background: var(--tblr-bg-surface-secondary);
    animation: dv-skeleton-pulse 1.6s ease-in-out infinite;
  }
  @keyframes dv-skeleton-pulse {
    0%, 100% { opacity: .55; }
    50%      { opacity: .85; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dv-skeleton-card { animation: none; }
  }
</style>

<div class="container-xl">
  {% if not configured %}
    <div class="alert alert-warning">{{ 'discover.error.not_configured'|trans }}</div>
  {% endif %}

  {# Same toolbar language as the Discover tab: one search field, then pill
     action buttons that toggle panels. Styles come from the shell's
     _toolbar_styles.html.twig, so they are present whichever tab loaded. #}
  <div id="dv-tabs" class="tmdb-searchbar">
    <div class="tmdb-search-wrap">
      <svg class="tmdb-search-ico" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"/>
        <path d="M21 21l-6 -6"/>
      </svg>
      <input id="dv-search" type="search" class="tmdb-search-input"
             placeholder="{{ 'discover.search.placeholder'|trans }}" autocomplete="off">
      <kbd class="tmdb-search-kbd d-none d-md-inline">MDBList</kbd>
    </div>
    <div class="tmdb-action-btns">
      <button type="button" class="tmdb-action-btn" id="dv-filters-toggle">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 4h18M7 12h10M11 20h2"/>
        </svg>
        {{ 'discover.filters.button'|trans }}
        <span class="tmdb-filter-badge" id="dv-filter-count" style="display:none;">0</span>
      </button>
      <button type="button" class="tmdb-action-btn" id="dv-add-toggle">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 5v14M5 12h14"/>
        </svg>
        {{ 'discover.add.button'|trans }}
      </button>
      <span class="text-secondary small" id="dv-count">{% if totalRows > 0 %}{{ 'discover.search.count'|trans({count: totalRows}) }}{% endif %}</span>
      <span class="dv-cap-note small{% if totalRows <= rowCap %} d-none{% endif %}" id="dv-cap-note">{% if totalRows > rowCap %}{{ 'discover.rows.capped'|trans({count: rowCap, total: totalRows}) }}{% endif %}</span>
    </div>
  </div>

  {# Add a list by URL. Panel rather than an inline input group, so the toolbar
     stays one clean row and matches the Filters affordance next to it. #}
  <div id="dv-add-panel" class="card mb-3" style="display:none;">
    <div class="card-body py-2">
      <div class="row g-2 align-items-end">
        <div class="col-md-6">
          <label class="form-label small mb-1" for="dv-add-url">{{ 'discover.add.label'|trans }}</label>
          <input type="url" class="form-control form-control-sm" id="dv-add-url"
                 placeholder="{{ 'discover.add.placeholder'|trans }}">
        </div>
        <div class="col-auto">
          <button type="button" class="btn btn-primary btn-sm" id="dv-add-btn">{{ 'discover.add.button'|trans }}</button>
        </div>
        <div class="col-auto">
          <span class="small d-none" id="dv-add-msg"></span>
        </div>
      </div>
    </div>
  </div>

  {# Filter panel. Genre is deliberately absent: MDBList list items carry
     id, type, title, year, poster and vote but no genres, so a genre control
     would need one extra API call per row and the free plan allows 1000 a
     day. Genre belongs with the server-side filtering in bead projects-o31. #}
  <div id="dv-filters" class="card mb-3" style="display:none;">
    <div class="card-body py-2">
      <div class="row g-2 align-items-end">
        <div class="col-auto">
          <label class="form-label small mb-1">{{ 'discover.filters.type'|trans }}</label>
          <div class="btn-group btn-group-sm" role="group">
            <input type="radio" class="btn-check" name="dv-filter-type" id="dv-type-all" value="" checked>
            <label class="btn btn-outline-primary btn-sm" for="dv-type-all">{{ 'discover.filters.all'|trans }}</label>
            <input type="radio" class="btn-check" name="dv-filter-type" id="dv-type-movie" value="movie">
            <label class="btn btn-outline-primary btn-sm" for="dv-type-movie">{{ 'discover.filters.movies'|trans }}</label>
            <input type="radio" class="btn-check" name="dv-filter-type" id="dv-type-tv" value="tv">
            <label class="btn btn-outline-primary btn-sm" for="dv-type-tv">{{ 'discover.filters.series'|trans }}</label>
          </div>
        </div>
        <div class="col-auto">
          <label class="form-label small mb-1" for="dv-year-min">{{ 'discover.filters.year_from'|trans }}</label>
          <input type="number" class="form-control form-control-sm" id="dv-year-min" placeholder="1970" min="1900" max="2100" style="width:90px;">
        </div>
        <div class="col-auto">
          <label class="form-label small mb-1" for="dv-year-max">{{ 'discover.filters.year_to'|trans }}</label>
          <input type="number" class="form-control form-control-sm" id="dv-year-max" placeholder="2030" min="1900" max="2100" style="width:90px;">
        </div>
        <div class="col-auto" style="min-width:150px;">
          <label class="form-label small mb-1" for="dv-vote-min">
            {{ 'discover.filters.vote_min'|trans }} <span id="dv-vote-val" class="fw-medium">0</span>
          </label>
          <input type="range" class="form-range" id="dv-vote-min" min="0" max="10" step="0.5" value="0">
        </div>
        <div class="col-md-2">
          <label class="form-label small mb-1" for="dv-sort">{{ 'discover.filters.sort'|trans }}</label>
          <select class="form-select form-select-sm" id="dv-sort">
            <option value="">{{ 'discover.filters.sort_options.default'|trans }}</option>
            <option value="rating">{{ 'discover.filters.sort_options.rating'|trans }}</option>
            <option value="year_desc">{{ 'discover.filters.sort_options.year_desc'|trans }}</option>
            <option value="year_asc">{{ 'discover.filters.sort_options.year_asc'|trans }}</option>
            <option value="title">{{ 'discover.filters.sort_options.title'|trans }}</option>
          </select>
        </div>
        <div class="col-auto">
          <button type="button" class="btn btn-ghost-secondary btn-sm" id="dv-filter-reset">{{ 'discover.filters.reset'|trans }}</button>
        </div>
      </div>
    </div>
  </div>

  
  {# Filled client-side from /trakt/playback (see loadContinueWatching()
     below). Kept outside #dv-directory so a search or "back to lists" pass,
     which rewrites that container's innerHTML, never wipes it out. Left
     empty (no card markup, no styling hook) whenever there is nothing to
     show, so no empty row is ever visible. #}
  <div id="dv-continue-watching"></div>

  {# Row shells (title, owner, counts) are rendered here so the directory
     never needs a client fetch just to know what rows exist. The first
     inlineRows rows also carry their cards already (see initialRows below,
     filled in by the script at the bottom); the rest show skeleton
     placeholders until the IntersectionObserver loads them. #}
  <div id="dv-directory">
    {% for row in rows %}
      <div class="tmdb-section">
        <div class="tmdb-section-header">
          <h3>
            <a href="#" class="dv-row-title" data-url="{{ row.url|e('html_attr') }}" data-label="{{ row.label|e('html_attr') }}">{% if row.pinned %}📌 {% endif %}{{ row.label }}</a>
            <span class="count">· {% if row.pinned %}{{ row.source }}{% else %}{{ row.user }} · {{ 'discover.list.items_count'|trans({count: row.items}) }} · {{ 'discover.list.likes_count'|trans({count: row.likes}) }}{% endif %}</span>
          </h3>
          <div class="tmdb-section-actions">
            <button type="button" class="tmdb-scroll-btn" data-scroll="left" aria-label="{{ 'discover.scroll.prev'|trans }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M15 6l-6 6l6 6"/></svg>
            </button>
            <button type="button" class="tmdb-scroll-btn" data-scroll="right" aria-label="{{ 'discover.scroll.next'|trans }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l6 6l-6 6"/></svg>
            </button>
          </div>
        </div>
        <div class="tmdb-row" data-url="{{ row.url|e('html_attr') }}"{% if loop.index0 < inlineRows %} data-loaded="1"{% endif %}>
          {% if loop.index0 >= inlineRows %}
            {% for i in 1..6 %}<div class="dv-skeleton-card" aria-hidden="true"></div>{% endfor %}
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {# Filter results. A filter has to see EVERY list, but rows load lazily, so
     filtering only what is on screen would silently ignore the rows not
     scrolled to yet. When a filter is on, every row is fetched (read-through
     cached server-side, which is what makes the fan-out affordable) and the
     matches are shown here as one grid instead of scattered across 24 rows. #}
  <div id="dv-filter-view" class="d-none">
    <div class="dv-toolbar">
      <strong id="dv-filter-heading"></strong>
      <span class="text-secondary small" id="dv-filter-progress"></span>
    </div>
    <div class="tmdb-results-grid" id="dv-filter-grid"></div>
    <div class="wl-empty text-secondary d-none" id="dv-filter-empty"></div>
  </div>

  <div id="dv-list-view" class="d-none">
    <div class="dv-toolbar">
      <button type="button" class="btn btn-sm btn-outline-secondary" id="dv-back">{{ 'discover.action.back'|trans }}</button>
      <strong id="dv-list-title"></strong>
      <button type="button" class="btn btn-sm btn-outline-primary" id="dv-pin"></button>
    </div>
    <div class="tmdb-results-grid" id="dv-grid"></div>
    <div class="text-center my-3">
      <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="dv-more">{{ 'discover.action.more'|trans }}</button>
    </div>
  </div>
</div>

<script>
(function () {
  var ROUTES = {
    lists: {{ path('lists_directory')|json_encode|raw }},
    list:  {{ path('lists_items')|json_encode|raw }},
    // One URL per type: the route requires `movie|tv`, so a placeholder such
    // as 'TYPE' would throw InvalidParameterException when Twig renders it.
    meta: {
      movie: {{ path('trakt_meta', {type: 'movie', tmdbId: 0})|json_encode|raw }},
      tv:    {{ path('trakt_meta', {type: 'tv',    tmdbId: 0})|json_encode|raw }}
    },
    pin:   {{ path('lists_pin')|json_encode|raw }},
    unpin: {{ path('lists_unpin')|json_encode|raw }}
  };

  var pinned = {{ pinned|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  /* Same identity rule as ListSourceResolver::idFor() on the server: trailing
     slash and case are both ignored. Comparing case-sensitively here would show
     "Pin" for a list that is in fact already pinned. */
  function pinKey(url) {
    return String(url || '').trim().replace(/\/$/, '').toLowerCase();
  }

  function isPinned(url) {
    return pinned.some(function (p) { return pinKey(p.url) === pinKey(url); });
  }

  // The rows and cards DiscoverController::index() already fetched and
  // rendered server-side, keyed by row url so wireDirectoryRows() below can
  // find them without a fetch of its own.
  var initialRows = {{ initialRows|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};

  // Rendering every list MDBList returns as its own row would mean up to 50
  // observers and 50 potential fetch chains on one page load. MDBList's free
  // plan allows 1000 requests/day, so the directory is capped here and each
  // row only fetches once it is about to scroll into view (see observeRow).
  var ROW_CAP = {{ rowCap }};

  var directory  = document.getElementById('dv-directory');
  var continueWatchingRow = document.getElementById('dv-continue-watching');
  var listView   = document.getElementById('dv-list-view');
  var grid       = document.getElementById('dv-grid');
  var moreBtn    = document.getElementById('dv-more');
  var title      = document.getElementById('dv-list-title');
  var count      = document.getElementById('dv-count');
  var capNote    = document.getElementById('dv-cap-note');
  var search     = document.getElementById('dv-search');
  var current    = { url: '', cursor: null };
  var rowObserver = null;

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  }); }

  function listsCountText(n) {
    return {{ 'discover.search.count'|trans({count: '__N__'})|json_encode|raw }}.replace('__N__', n);
  }
  function itemsCountText(n) {
    return {{ 'discover.list.items_count'|trans({count: '__N__'})|json_encode|raw }}.replace('__N__', n);
  }
  function likesCountText(n) {
    return {{ 'discover.list.likes_count'|trans({count: '__N__'})|json_encode|raw }}.replace('__N__', n);
  }
  function cappedText(shown, total) {
    return {{ 'discover.rows.capped'|trans({count: '__N__', total: '__T__'})|json_encode|raw }}
      .replace('__N__', shown).replace('__T__', total);
  }

  var SCROLL_PREV = {{ 'discover.scroll.prev'|trans|json_encode|raw }};
  var SCROLL_NEXT = {{ 'discover.scroll.next'|trans|json_encode|raw }};
  var ROW_EMPTY   = {{ 'discover.row.empty'|trans|json_encode|raw }};
  var CONTINUE_WATCHING_LABEL = {{ 'discover.row.continue_watching'|trans|json_encode|raw }};
  // Trakt playback entries have no title, poster or year: the caller has to
  // resolve those itself. Bounded to a sensible number so this never turns
  // into a burst of per-title lookups.
  var CONTINUE_WATCHING_CAP = 12;

  var SCROLL_BTNS_HTML =
      '<div class="tmdb-section-actions">'
    + '<button type="button" class="tmdb-scroll-btn" data-scroll="left" aria-label="' + esc(SCROLL_PREV) + '">'
    +   '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M15 6l-6 6l6 6"/></svg>'
    + '</button>'
    + '<button type="button" class="tmdb-scroll-btn" data-scroll="right" aria-label="' + esc(SCROLL_NEXT) + '">'
    +   '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l6 6l-6 6"/></svg>'
    + '</button>'
    + '</div>';

  /* MEASURED 2026-08-23: MDBList returns an absolute poster URL on every
     item, so in practice this loop does nothing. It stays as a cheap safety
     net for the rare item with no poster, and costs one request only for
     those. */
  function hydrate(items, container) {
    items.forEach(function (it) {
      if (it.poster) return;
      var template = ROUTES.meta[it.type];
      if (!template) return;
      var url = template.replace(/0$/, String(it.id));
      fetch(url, { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (m) {
          if (!m || !m.poster) return;
          var card = container.querySelector('.media-card[data-tmdb-id="' + it.id + '"]');
          if (!card) return;
          var ph = card.querySelector('.no-poster');
          if (ph) ph.outerHTML = '<img src="' + m.poster + '" alt="" loading="lazy">';
        })
        .catch(function () {});
    });
  }

  function renderPage(d, append) {
    var html = (d.items || []).map(window.renderCardHTML).join('');
    if (append) { grid.insertAdjacentHTML('beforeend', html); } else { grid.innerHTML = html; }
    current.cursor = d.next_cursor || null;
    moreBtn.classList.toggle('d-none', !current.cursor);
    hydrate(d.items || [], grid);
  }

  function openList(url, label) {
    current.url = url;
    current.cursor = null;
    title.textContent = label;
    var pinBtn = document.getElementById('dv-pin');
    pinBtn.textContent = isPinned(url)
      ? {{ 'discover.action.unpin'|trans|json_encode|raw }}
      : {{ 'discover.action.pin'|trans|json_encode|raw }};
    pinBtn.onclick = function () {
      var unpinning = isPinned(url);
      var target = unpinning ? ROUTES.unpin : ROUTES.pin;
      var body   = unpinning
        ? { id: (pinned.filter(function (p) { return pinKey(p.url) === pinKey(url); })[0] || {}).id }
        : { url: url, label: label };
      fetch(target, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body)
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.ok) return;
          pinned = d.pinned || [];
          pinBtn.textContent = isPinned(url)
            ? {{ 'discover.action.unpin'|trans|json_encode|raw }}
            : {{ 'discover.action.pin'|trans|json_encode|raw }};
        });
    };
    directory.classList.add('d-none');
    listView.classList.remove('d-none');
    grid.innerHTML = '';
    fetch(ROUTES.list + '?src=' + encodeURIComponent(url), { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (d) { renderPage(d, false); });
  }

  // ── Row shells: rendered immediately for structure, filled on demand ──
  // Used only by loadDirectory() below, for a search or a return from an
  // open list: the very first paint uses the shells already in the HTML
  // (see wireDirectoryRows()), never this.
  function rowShellHTML(row) {
    var pin = row.pinned ? '📌 ' : '';
    return '<div class="tmdb-section">'
      + '<div class="tmdb-section-header">'
      +   '<h3>'
      +     '<a href="#" class="dv-row-title" data-url="' + esc(row.url) + '" data-label="' + esc(row.label) + '">' + pin + esc(row.label) + '</a>'
      +     '<span class="count">· ' + row.meta + '</span>'
      +   '</h3>'
      +   SCROLL_BTNS_HTML
      + '</div>'
      + '<div class="tmdb-row" data-url="' + esc(row.url) + '"></div>'
      + '</div>';
  }

  function buildRows(d) {
    var pins = (d.pinned || []).map(function (p) {
      return { url: p.url, label: p.label, pinned: true, meta: esc(p.source) };
    });
    // A pinned list is usually also in the top-lists directory. Rendering both
    // would give two identical carousels, so the pinned copy wins.
    var seen = {};
    pins.forEach(function (p) { seen[pinKey(p.url)] = true; });

    var lists = (d.lists || []).filter(function (l) {
      return !seen[pinKey(l.url)];
    }).map(function (l) {
      return {
        url: l.url, label: l.name, pinned: false,
        meta: esc(l.user) + ' · ' + itemsCountText(esc(l.items)) + ' · ' + likesCountText(esc(l.likes))
      };
    });
    return pins.concat(lists);
  }

  // A row only calls /lists/items once it is about to scroll into view.
  function observeRow(rowEl) {
    if (!rowObserver) {
      rowObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          var row = entry.target;
          rowObserver.unobserve(row);
          if (row.dataset.loaded === '1' || row.dataset.loading === '1') return;
          loadRowPage(row, row.dataset.url, null, false);
        });
      }, { rootMargin: '600px 0px' });
    }
    rowObserver.observe(rowEl);
  }

  // Infinite horizontal scroll: fetch the next page once a row nears its
  // right edge, guarded so a row already loading never fires twice.
  function onRowScroll(e) {
    var row = e.target;
    if (row.dataset.loading === '1' || !row.dataset.cursor) return;
    if (row.scrollLeft + row.clientWidth < row.scrollWidth - 300) return;
    loadRowPage(row, row.dataset.url, row.dataset.cursor, true);
  }

  function loadRowPage(rowEl, url, cursor, append) {
    rowEl.dataset.loading = '1';
    var qs = '?src=' + encodeURIComponent(url) + (cursor ? '&cursor=' + encodeURIComponent(cursor) : '');
    fetch(ROUTES.list + qs, { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var items = d.items || [];
        var html = items.map(window.renderCardHTML).join('');
        if (append) {
          rowEl.insertAdjacentHTML('beforeend', html);
        } else {
          rowEl.innerHTML = html || '<div class="text-secondary py-2 px-2">' + ROW_EMPTY + '</div>';
        }
        rowEl.dataset.cursor = d.next_cursor || '';
        rowEl.dataset.loaded = '1';
        rowEl.dataset.loading = '0';
        hydrate(items, rowEl);
      })
      .catch(function () {
        rowEl.dataset.loading = '0';
        rowEl.dataset.loaded = '1';
      });
  }

  function loadDirectory(q) {
    if (rowObserver) { rowObserver.disconnect(); }
    directory.innerHTML = '';
    fetch(ROUTES.lists + (q ? '?q=' + encodeURIComponent(q) : ''), { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var rows  = buildRows(d);
        var shown = rows.slice(0, ROW_CAP);

        count.textContent = rows.length ? listsCountText(rows.length) : '';
        if (rows.length > shown.length) {
          capNote.textContent = cappedText(shown.length, rows.length);
          capNote.classList.remove('d-none');
        } else {
          capNote.classList.add('d-none');
        }

        directory.innerHTML = shown.map(rowShellHTML).join('');

        Array.prototype.forEach.call(directory.querySelectorAll('.tmdb-row'), function (rowEl) {
          rowEl.addEventListener('scroll', onRowScroll);
          observeRow(rowEl);
        });
      });
  }

  // First paint: the row shells (and the first rows' cards) are already in
  // the HTML DiscoverController::index() rendered, so this only wires up
  // scrolling and lazy-loading instead of fetching anything.
  function wireDirectoryRows() {
    Array.prototype.forEach.call(directory.querySelectorAll('.tmdb-row'), function (rowEl) {
      var pre = initialRows[rowEl.dataset.url];
      if (pre) {
        var items = pre.items || [];
        rowEl.innerHTML = items.map(window.renderCardHTML).join('') || '<div class="text-secondary py-2 px-2">' + ROW_EMPTY + '</div>';
        rowEl.dataset.cursor = pre.next_cursor || '';
        rowEl.dataset.loaded = '1';
        hydrate(items, rowEl);
      }
      rowEl.addEventListener('scroll', onRowScroll);
      observeRow(rowEl);
    });
  }

  // Shared by #dv-directory and #dv-continue-watching: both are carousels
  // of .tmdb-section rows built from the same markup. A row title is only
  // ever a real list link inside the directory (.dv-row-title carries a
  // data-url there); a container without any just falls through to the
  // card-click handling below.
  function bindRowClicks(container) {
    if (!container) return;
    container.addEventListener('click', function (e) {
      var scrollBtn = e.target.closest('.tmdb-scroll-btn');
      if (scrollBtn) {
        var section = scrollBtn.closest('.tmdb-section');
        var row = section && section.querySelector('.tmdb-row');
        if (row) {
          var dir = scrollBtn.dataset.scroll === 'right' ? 1 : -1;
          row.scrollBy({ left: dir * row.clientWidth * 0.75, behavior: 'smooth' });
        }
        return;
      }
      var titleLink = e.target.closest('.dv-row-title');
      if (titleLink) {
        e.preventDefault();
        openList(titleLink.dataset.url, titleLink.dataset.label);
        return;
      }
      if (e.target.closest('.tmdb-add-btn') || e.target.closest('.h-actions') || e.target.closest('a') || e.target.closest('.wl-star') || e.target.closest('.dv-kebab-wrap')) return;
      var card = e.target.closest('.media-card[data-tmdb-id]');
      if (card && window.PrismarrDetail) {
        window.PrismarrDetail.load(card.dataset.tmdbType, card.dataset.tmdbId);
      }
    });
  }

  bindRowClicks(directory);
  bindRowClicks(continueWatchingRow);

  // "Continue watching" row: the playback map carries title and year
  // directly (TraktClient::getPlayback() reads them off the /sync/playback
  // media object), but no poster or vote, so each entry still needs its own
  // /trakt/meta lookup for those (the same one the in-library hydrate()
  // path above uses for MDBList items missing a poster). Silent on any
  // failure or an empty map: no row, no error.
  function loadContinueWatching() {
    if (!continueWatchingRow) return;

    fetch('/trakt/playback', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (map) {
        if (!map || typeof map !== 'object') return;

        var entries = Object.keys(map).map(function (key) {
          var sep  = key.indexOf(':');
          var type = key.slice(0, sep);
          var id   = key.slice(sep + 1);
          return {
            type: type, id: id,
            paused_at: map[key].paused_at || '',
            title: map[key].title || '',
            year: map[key].year || null
          };
        });
        if (entries.length === 0) return;

        // ISO 8601 timestamps sort lexically, most recently paused first.
        entries.sort(function (a, b) { return b.paused_at.localeCompare(a.paused_at); });
        entries = entries.slice(0, CONTINUE_WATCHING_CAP);

        return Promise.all(entries.map(function (e) {
          var template = ROUTES.meta[e.type];
          if (!template) return null;
          var url = template.replace(/0$/, String(e.id));
          return fetch(url, { headers: { Accept: 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (m) {
              return { id: e.id, type: e.type, title: e.title, year: e.year, poster: m && m.poster, vote: m && m.vote };
            })
            .catch(function () { return null; });
        })).then(function (items) {
          items = items.filter(Boolean);
          if (items.length === 0) return;

          continueWatchingRow.innerHTML = '<div class="tmdb-section">'
            + '<div class="tmdb-section-header">'
            +   '<h3>' + esc(CONTINUE_WATCHING_LABEL) + '</h3>'
            +   SCROLL_BTNS_HTML
            + '</div>'
            + '<div class="tmdb-row">' + items.map(window.renderCardHTML).join('') + '</div>'
            + '</div>';
        });
      })
      .catch(function () { /* no row, no noise */ });
  }

  grid.addEventListener('click', function (e) {
    if (e.target.closest('.tmdb-add-btn') || e.target.closest('.h-actions') || e.target.closest('a') || e.target.closest('.wl-star') || e.target.closest('.dv-kebab-wrap')) return;
    var card = e.target.closest('.media-card[data-tmdb-id]');
    if (card && window.PrismarrDetail) {
      window.PrismarrDetail.load(card.dataset.tmdbType, card.dataset.tmdbId);
    }
  });

  moreBtn.addEventListener('click', function () {
    if (!current.cursor) return;
    moreBtn.disabled = true;
    fetch(ROUTES.list + '?src=' + encodeURIComponent(current.url) + '&cursor=' + encodeURIComponent(current.cursor),
          { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (d) { renderPage(d, true); moreBtn.disabled = false; });
  });

  document.getElementById('dv-back').addEventListener('click', function () {
    listView.classList.add('d-none');
    directory.classList.remove('d-none');
    // Redraw so a list pinned or unpinned while it was open is reflected in the
    // pinned strip straight away, rather than after the next search keystroke.
    loadDirectory(search.value.trim());
  });

  var timer = null;
  search.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () { loadDirectory(search.value.trim()); }, 300);
  });

  // ── Toolbar panels ───────────────────────────────────────────────────
  var addPanel   = document.getElementById('dv-add-panel');
  var addToggle  = document.getElementById('dv-add-toggle');
  var filtPanel  = document.getElementById('dv-filters');
  var filtToggle = document.getElementById('dv-filters-toggle');

  function togglePanel(panel, btn) {
    var open = panel.style.display !== 'none';
    panel.style.display = open ? 'none' : '';
    btn.classList.toggle('active', !open);
  }

  addToggle.addEventListener('click', function () {
    togglePanel(addPanel, addToggle);
    if (addPanel.style.display !== 'none') { addUrl.focus(); }
  });
  filtToggle.addEventListener('click', function () { togglePanel(filtPanel, filtToggle); });

  // ── Pin a list by URL ────────────────────────────────────────────────
  var addUrl = document.getElementById('dv-add-url');
  var addBtn = document.getElementById('dv-add-btn');
  var addMsg = document.getElementById('dv-add-msg');

  function showAddMsg(text, isError) {
    addMsg.textContent = text;
    addMsg.classList.remove('d-none', 'text-danger', 'text-success');
    addMsg.classList.add(isError ? 'text-danger' : 'text-success');
  }

  function submitAdd() {
    var url = addUrl.value.trim();
    if (!url) return;

    addBtn.disabled = true;
    addMsg.classList.add('d-none');

    fetch(ROUTES.pin, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ url: url })
    })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, body: d }; }); })
      .then(function (res) {
        if (!res.ok || !res.body.ok) {
          showAddMsg({{ 'discover.add.unsupported'|trans|json_encode|raw }}, true);
          return;
        }
        pinned = res.body.pinned || [];
        addUrl.value = '';
        showAddMsg({{ 'discover.add.added'|trans|json_encode|raw }}, false);
        loadDirectory(search.value.trim());
      })
      .catch(function () {
        showAddMsg({{ 'discover.add.failed'|trans|json_encode|raw }}, true);
      })
      .finally(function () { addBtn.disabled = false; });
  }

  addBtn.addEventListener('click', submitAdd);
  addUrl.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); submitAdd(); }
  });

  // ── Filters ──────────────────────────────────────────────────────────
  // Applied to cards already in the DOM rather than refetched: every row is
  // a separate MDBList call and the free plan allows 1000 a day, so filtering
  // must never cost a request. Rows loaded later are filtered by the
  // MutationObserver below, so a lazy row arrives already filtered.
  var yearMin = document.getElementById('dv-year-min');
  var yearMax = document.getElementById('dv-year-max');
  var voteMin = document.getElementById('dv-vote-min');
  var voteVal = document.getElementById('dv-vote-val');
  var sortSel = document.getElementById('dv-sort');
  var filtCount = document.getElementById('dv-filter-count');

  function currentFilters() {
    var typeEl = document.querySelector('input[name="dv-filter-type"]:checked');
    return {
      type: typeEl ? typeEl.value : '',
      yearMin: parseInt(yearMin.value, 10) || null,
      yearMax: parseInt(yearMax.value, 10) || null,
      voteMin: parseFloat(voteMin.value) || 0,
      sort: sortSel.value
    };
  }

  function activeCount(f) {
    var n = 0;
    if (f.type) n++;
    if (f.yearMin) n++;
    if (f.yearMax) n++;
    if (f.voteMin > 0) n++;
    if (f.sort) n++;
    return n;
  }

  function cardYear(card) {
    var el = card.querySelector('.card-year');
    var y = el ? parseInt(el.textContent, 10) : NaN;
    return isNaN(y) ? null : y;
  }

  function cardVote(card) {
    var el = card.querySelector('.vote-badge');
    if (!el) return null;
    var v = parseFloat((el.textContent || '').replace(/[^0-9.]/g, ''));
    return isNaN(v) ? null : v;
  }

  function cardMatches(card, f) {
    if (f.type && card.dataset.tmdbType !== f.type) return false;
    var y = cardYear(card);
    if (f.yearMin && (y === null || y < f.yearMin)) return false;
    if (f.yearMax && (y === null || y > f.yearMax)) return false;
    if (f.voteMin > 0) {
      var v = cardVote(card);
      if (v === null || v < f.voteMin) return false;
    }
    return true;
  }

  function sortContainer(container, f) {
    if (!f.sort) return;
    var cards = Array.from(container.querySelectorAll('.media-card'));
    cards.sort(function (a, b) {
      if (f.sort === 'rating')    return (cardVote(b) || 0) - (cardVote(a) || 0);
      if (f.sort === 'year_desc') return (cardYear(b) || 0) - (cardYear(a) || 0);
      if (f.sort === 'year_asc')  return (cardYear(a) || 9999) - (cardYear(b) || 9999);
      if (f.sort === 'title')     return (a.dataset.tmdbTitle || '').localeCompare(b.dataset.tmdbTitle || '');
      return 0;
    });
    cards.forEach(function (c) { container.appendChild(c); });
  }

  var FILTER_HEADING = {{ 'discover.filters.results'|trans|json_encode|raw }};
  var FILTER_LOADING = {{ 'discover.filters.scanning'|trans|json_encode|raw }};
  var FILTER_COUNT   = {{ 'discover.filters.matches'|trans|json_encode|raw }};
  var FILTER_EMPTY   = {{ 'discover.filters.none'|trans|json_encode|raw }};

  var filterView   = document.getElementById('dv-filter-view');
  var filterGrid   = document.getElementById('dv-filter-grid');
  var filterEmpty  = document.getElementById('dv-filter-empty');
  var filterProg   = document.getElementById('dv-filter-progress');
  var filterHead   = document.getElementById('dv-filter-heading');
  var fanoutToken  = 0;

  function anyFilterActive(f) {
    return !!(f.type || f.yearMin || f.yearMax || f.voteMin > 0);
  }

  function itemMatches(item, f) {
    if (f.type && item.type !== f.type) return false;
    var y = item.year ? parseInt(item.year, 10) : null;
    if (f.yearMin && (!y || y < f.yearMin)) return false;
    if (f.yearMax && (!y || y > f.yearMax)) return false;
    if (f.voteMin > 0) {
      var v = item.vote ? parseFloat(item.vote) : null;
      if (!v || v < f.voteMin) return false;
    }
    return true;
  }

  function sortItems(items, sort) {
    if (!sort) return items;
    return items.slice().sort(function (a, b) {
      if (sort === 'rating')    return (parseFloat(b.vote) || 0) - (parseFloat(a.vote) || 0);
      if (sort === 'year_desc') return (parseInt(b.year, 10) || 0) - (parseInt(a.year, 10) || 0);
      if (sort === 'year_asc')  return (parseInt(a.year, 10) || 9999) - (parseInt(b.year, 10) || 9999);
      if (sort === 'title')     return String(a.title || '').localeCompare(String(b.title || ''));
      return 0;
    });
  }

  // Every list the directory knows about, whether or not its row has been
  // scrolled into view.
  function allRowUrls() {
    return Array.prototype.slice.call(
      document.querySelectorAll('[data-dsc-pane="lists"] #dv-directory .tmdb-row[data-url]')
    ).map(function (r) { return r.dataset.url; });
  }

  // Fetch with a small concurrency cap: 24 parallel requests would hammer
  // MDBList, and the responses are cached server-side anyway so a repeat
  // filter costs nothing.
  function fetchAll(urls, token, onProgress) {
    var out = [];
    var idx = 0;
    var done = 0;
    var LANES = 4;

    return new Promise(function (resolve) {
      function next() {
        if (token !== fanoutToken) return resolve(out);
        if (idx >= urls.length) {
          if (done >= urls.length) resolve(out);
          return;
        }
        var url = urls[idx++];
        fetch(ROUTES.list + '?src=' + encodeURIComponent(url), { headers: { Accept: 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (d) { (d.items || []).forEach(function (i) { out.push(i); }); })
          .catch(function () { /* one dead list must not kill the filter */ })
          .finally(function () {
            done++;
            onProgress(done, urls.length);
            if (done >= urls.length && idx >= urls.length) { resolve(out); }
            else { next(); }
          });
      }
      for (var i = 0; i < Math.min(LANES, urls.length); i++) next();
    });
  }

  function showDirectory() {
    filterView.classList.add('d-none');
    directory.classList.remove('d-none');
  }

  function applyFilters() {
    var f = currentFilters();
    var n = activeCount(f);
    filtCount.textContent = n;
    filtCount.style.display = n ? '' : 'none';

    // An open single list keeps the old in-place behaviour: everything it
    // holds is already in the DOM, so there is nothing to fan out to.
    if (!listView.classList.contains('d-none')) {
      document.querySelectorAll('#dv-grid .media-card').forEach(function (card) {
        card.style.display = cardMatches(card, f) ? '' : 'none';
      });
      sortContainer(grid, f);
      return;
    }

    if (!anyFilterActive(f)) {
      fanoutToken++;
      showDirectory();
      // Sorting with no filter still applies, in place, to loaded rows.
      document.querySelectorAll('[data-dsc-pane="lists"] .tmdb-row').forEach(function (c) {
        Array.prototype.slice.call(c.querySelectorAll('.media-card'))
          .forEach(function (card) { card.style.display = ''; });
        sortContainer(c, f);
      });
      return;
    }

    var token = ++fanoutToken;
    var urls  = allRowUrls();

    directory.classList.add('d-none');
    filterView.classList.remove('d-none');
    filterEmpty.classList.add('d-none');
    filterGrid.innerHTML = '';
    filterHead.textContent = FILTER_HEADING;
    filterProg.textContent = FILTER_LOADING.replace('__DONE__', 0).replace('__TOTAL__', urls.length);

    fetchAll(urls, token, function (done, total) {
      if (token !== fanoutToken) return;
      filterProg.textContent = FILTER_LOADING.replace('__DONE__', done).replace('__TOTAL__', total);
    }).then(function (items) {
      if (token !== fanoutToken) return;

      // One list can appear in several rows (a pinned list also shows in the
      // directory), so the same title would otherwise render twice.
      var seen = {};
      var matches = [];
      items.forEach(function (it) {
        var key = it.type + ':' + it.id;
        if (seen[key]) return;
        seen[key] = 1;
        if (itemMatches(it, f)) matches.push(it);
      });

      matches = sortItems(matches, f.sort);
      filterProg.textContent = FILTER_COUNT.replace('__N__', matches.length);
      filterGrid.innerHTML = matches.map(window.renderCardHTML).join('');
      filterEmpty.textContent = FILTER_EMPTY;
      filterEmpty.classList.toggle('d-none', matches.length > 0);
      hydrate(matches, filterGrid);
    });
  }

  [yearMin, yearMax].forEach(function (el) { el.addEventListener('input', applyFilters); });
  voteMin.addEventListener('input', function () {
    voteVal.textContent = voteMin.value;
    applyFilters();
  });
  sortSel.addEventListener('change', applyFilters);
  document.querySelectorAll('input[name="dv-filter-type"]').forEach(function (el) {
    el.addEventListener('change', applyFilters);
  });

  document.getElementById('dv-filter-reset').addEventListener('click', function () {
    document.getElementById('dv-type-all').checked = true;
    yearMin.value = '';
    yearMax.value = '';
    voteMin.value = 0;
    voteVal.textContent = '0';
    sortSel.value = '';
    applyFilters();
  });

  // No MutationObserver here any more. It used to re-filter rows as they
  // arrived, which was only needed because filtering read the DOM. The filter
  // now fans out and renders its own grid, and an observer would re-trigger
  // that fan-out every time the grid was written.

  window.PrismarrDiscover = { routes: ROUTES, openList: openList, current: current };
  wireDirectoryRows();
  loadContinueWatching();
})();
</script>
</div>
