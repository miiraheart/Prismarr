{% extends 'base.html.twig' %}

{% block title %}{{ 'discover.page.title'|trans }}{% endblock %}
{% block page_title %}<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#6366f1" stroke="#6366f1" stroke-width="1.5" stroke-linejoin="round"><path d="M12 2l2.4 7.4h7.6l-6.2 4.5l2.4 7.4l-6.2 -4.6l-6.2 4.6l2.4 -7.4l-6.2 -4.5h7.6z"/></svg> {{ 'discover.page.title'|trans }}{% endblock %}

{% block body %}
<style>
  /* The tab bar only. Everything inside a pane keeps the styles it arrived
     with, which is why the moved templates were not restyled. */
  .dsc-tabbar { display:flex; gap:.25rem; border-bottom:1px solid var(--tblr-border-color); margin-bottom:1rem; }
  .dsc-tab { appearance:none; background:none; border:0; border-bottom:2px solid transparent;
             padding:.5rem .9rem; color:var(--tblr-secondary); font-weight:500; cursor:pointer; }
  .dsc-tab:hover { color:var(--tblr-body-color); }
  .dsc-tab.active { color:var(--tblr-primary); border-bottom-color:var(--tblr-primary); }
  .dsc-pane[hidden] { display:none; }
  .dsc-loading { padding:2rem; text-align:center; color:var(--tblr-secondary); }
</style>

{# The tab bar id is dsc-tabs, NOT dv-tabs: the Lists tab body already uses
   #dv-tabs for its own search-and-pin toolbar. #}
<div id="dsc-tabs" class="dsc-tabbar" role="tablist">
  {% for t in tabs %}
    <button type="button" class="dsc-tab{% if t == activeTab %} active{% endif %}"
            role="tab" data-dsc-tab="{{ t }}"
            aria-selected="{{ t == activeTab ? 'true' : 'false' }}">
      {{ ('discover.tab.' ~ t)|trans }}
    </button>
  {% endfor %}
</div>

{# Toolbar styles shared by every tab. Must be in the shell, not in a pane:
   only the active pane is server rendered, so a tab-local copy is missing
   whenever a different tab is the one that loaded. #}
{% include 'discover/_toolbar_styles.html.twig' %}

{# Included ONCE here rather than once per tab, and BEFORE the panes.

   The order matters: the modal partial is what defines window.renderCardHTML,
   and a server-rendered tab's own inline script runs as the document is
   parsed. Including the modal after the panes left the Trakt tab calling
   renderCardHTML before it existed, which threw and rendered zero cards. #}
{% include 'decouverte/_detail_modal.html.twig' %}

{# Only the active pane is server rendered. The others are fetched once, on
   first click, and then kept in the DOM so every later switch is instant. #}
<div id="dsc-panes">
  {% for t in tabs %}
    <div class="dsc-pane" data-dsc-host="{{ t }}"{% if t != activeTab %} hidden{% endif %}>
      {% if t == activeTab %}{{ activeTabHtml|raw }}{% endif %}
    </div>
  {% endfor %}
</div>

<script>
(function () {
  {# A real URL per tab. A placeholder like __TAB__ cannot be used here: the
     route requirement rejects any value outside discover|lists|trakt at
     generation time. #}
  var TAB_URLS = {
    {% for t in tabs %}{{ t|json_encode|raw }}: {{ path('discover_page_tab', {tab: t})|json_encode|raw }}{{ loop.last ? '' : ',' }}
    {% endfor %}
  };
  var LOADING  = {{ 'discover.tab.loading'|trans|json_encode|raw }};
  var FAILED   = {{ 'discover.tab.failed'|trans|json_encode|raw }};
  var bar = document.getElementById('dsc-tabs');
  if (!bar) return;

  function host(tab) { return document.querySelector('[data-dsc-host="' + tab + '"]'); }

  function show(tab) {
    bar.querySelectorAll('[data-dsc-tab]').forEach(function (b) {
      var on = b.dataset.dscTab === tab;
      b.classList.toggle('active', on);
      b.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    document.querySelectorAll('[data-dsc-host]').forEach(function (p) {
      p.hidden = p.dataset.dscHost !== tab;
    });
  }

  function activate(tab) {
    var pane = host(tab);
    if (!pane) return;
    show(tab);

    var url = new URL(window.location.href);
    url.searchParams.set('tab', tab);
    window.history.replaceState({}, '', url);

    // Already loaded: nothing to fetch, which is what makes the second and
    // every later switch instant.
    if (pane.dataset.dscLoaded === '1' || pane.children.length) {
      pane.dataset.dscLoaded = '1';
      return;
    }

    pane.innerHTML = '<div class="dsc-loading">' + LOADING + '</div>';
    fetch(TAB_URLS[tab], {headers: {'X-Requested-With': 'XMLHttpRequest'}})
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
      .then(function (html) {
        pane.innerHTML = html;
        pane.dataset.dscLoaded = '1';
        // The injected markup carries its own <script> blocks, which the
        // browser does not execute on innerHTML assignment. Re-create each
        // one so the tab's own behaviour actually starts.
        //
        // Only EXECUTABLE scripts. A tab may also ship a data island such as
        // the Trakt tab's <script type="application/json" id="tk-items">, and
        // innerHTML already placed that in the DOM intact. Re-creating it
        // dropped its type and id, so the tab read an empty seed and rendered
        // nothing. Attributes are copied for the same reason.
        pane.querySelectorAll('script').forEach(function (old) {
          var type = (old.getAttribute('type') || '').toLowerCase();
          var executable = type === '' || type === 'module'
            || type === 'text/javascript' || type === 'application/javascript';
          if (!executable) return;

          var s = document.createElement('script');
          for (var i = 0; i < old.attributes.length; i++) {
            s.setAttribute(old.attributes[i].name, old.attributes[i].value);
          }
          if (!old.src) { s.textContent = old.textContent; }
          old.replaceWith(s);
        });
      })
      .catch(function () {
        pane.innerHTML = '<div class="dsc-loading">' + FAILED + '</div>';
      });
  }

  bar.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-dsc-tab]');
    if (btn) activate(btn.dataset.dscTab);
  });
}());
</script>
{% endblock %}
