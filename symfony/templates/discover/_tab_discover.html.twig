{# The Discover tab.
   Moved from decouverte/index.html.twig, which is upstream owned. The
   upstream file and its controller action are left exactly as they are and
   are now unreachable, so they keep fast-forward syncing from upstream. Do
   not edit that file; edit this one.

   The detail modal is NOT included here: the shell includes it once for all
   three tabs, so its handlers bind once. #}
{% import '_icons.html.twig' as ico %}

<div data-dsc-pane="discover">
<style>
  /* ── Structure de page : sections scrollables horizontales ── */
  .tmdb-section { margin-bottom: 1.75rem; }
  .tmdb-section-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 0.5rem; padding: 0 0.25rem;
  }
  .tmdb-section-header h3 {
    margin: 0; font-size: 1rem; font-weight: 600;
    color: var(--tblr-body-color);
  }
  .tmdb-section-header h3 .count {
    font-size: 0.75rem; color: var(--tblr-secondary); font-weight: 400;
    margin-left: 0.4rem;
  }
  .tmdb-section-actions { display: flex; gap: 0.25rem; }
  .tmdb-scroll-btn {
    width: 28px; height: 28px; border-radius: 50%;
    border: 1px solid var(--tblr-border-color);
    background: var(--tblr-bg-surface); color: var(--tblr-body-color);
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer; transition: all 0.15s;
  }
  .tmdb-scroll-btn:hover { background: var(--tblr-primary); color: #fff; border-color: var(--tblr-primary); }

  .tmdb-row {
    display: flex; gap: 0.75rem; overflow-x: auto; scroll-behavior: smooth;
    padding: 0.25rem 0.25rem 0.75rem; scrollbar-width: thin;
  }
  .tmdb-row::-webkit-scrollbar { height: 6px; }
  .tmdb-row::-webkit-scrollbar-thumb { background: var(--tblr-border-color); border-radius: 3px; }

  /* ── Search: query box, inline filters, best match, people ── */
  .srch { margin-bottom: 1.5rem; }
  .srch-bar {
    display: flex; align-items: center; gap: .75rem;
    background: var(--tblr-bg-surface);
    border: 1px solid var(--tblr-border-color);
    border-radius: .85rem; padding: .7rem 1rem;
    transition: border-color .15s, box-shadow .15s;
  }
  .srch-bar:focus-within { border-color: var(--tblr-primary); box-shadow: 0 0 0 4px rgba(var(--tblr-primary-rgb), .14); }
  .srch-ico { color: var(--tblr-muted); flex-shrink: 0; }
  .srch-bar:focus-within .srch-ico { color: var(--tblr-primary); }
  .srch-input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: var(--tblr-body-color); font-size: 1.05rem; }
  .srch-input::placeholder { color: var(--tblr-muted); }
  .srch-kbd {
    background: var(--tblr-bg-surface-secondary); color: var(--tblr-muted);
    border: 1px solid var(--tblr-border-color); border-radius: .3rem;
    font-size: .7rem; padding: .1rem .45rem; font-weight: 600;
  }
  .srch-filters { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; margin-top: .75rem; }
  @media (min-width: 992px) { .srch-filters { flex-wrap: nowrap; } .srch-filters > * { flex-shrink: 0; } }
  .srch-seg { display: inline-flex; border: 1px solid var(--tblr-border-color); border-radius: .5rem; overflow: hidden; }
  .srch-seg button { background: none; border: 0; color: var(--tblr-secondary); font-size: .8rem; padding: .3rem .6rem; cursor: pointer; }
  .srch-seg button + button { border-left: 1px solid var(--tblr-border-color); }
  .srch-seg button.is-active { background: rgba(var(--tblr-primary-rgb), .14); color: var(--tblr-primary); font-weight: 600; }
  .srch-select { width: auto; min-width: 0; font-size: .8rem; padding-top: .3rem; padding-bottom: .3rem; }
  .srch-check { display: inline-flex; align-items: center; gap: .35rem; font-size: .8rem; color: var(--tblr-secondary); cursor: pointer; white-space: nowrap; }
  .srch-reset { background: none; border: 0; font-size: .8rem; color: var(--tblr-primary); cursor: pointer; padding: .2rem .3rem; }
  .srch-btn {
    display: inline-flex; align-items: center; gap: .35rem; white-space: nowrap;
    padding: .32rem .7rem; border-radius: .5rem; font-size: .8rem; font-weight: 600; text-decoration: none;
    color: var(--tblr-primary); background: rgba(var(--tblr-primary-rgb), .1);
    border: 1px solid rgba(var(--tblr-primary-rgb), .35); transition: background .15s, border-color .15s;
  }
  .srch-btn:hover { color: var(--tblr-primary); background: rgba(var(--tblr-primary-rgb), .18); border-color: var(--tblr-primary); }
  .tmdb-filter-badge {
    display: inline-flex; align-items: center; justify-content: center;
    background: #ef4444; color: #fff; width: 16px; height: 16px; border-radius: 50%;
    font-size: .6rem; font-weight: 700; margin-left: .15rem;
  }
  .srch-status { font-size: .85rem; color: var(--tblr-secondary); margin: 0 0 .75rem .1rem; }
  .srch-correction { font-size: .95rem; margin: 0 0 .35rem .1rem; }
  .srch-inline-link { background: none; border: 0; padding: 0; color: var(--tblr-primary); font-weight: 600; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
  .srch-correction .srch-inline-link.is-quiet { font-weight: 400; color: var(--tblr-secondary); }
  .srch-label { font-size: .72rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--tblr-secondary); margin: 1.25rem 0 .6rem .1rem; }
  .srch-best {
    position: relative; border-radius: 1rem; overflow: hidden; margin-bottom: .5rem;
    background: var(--tblr-bg-surface-secondary) var(--srch-bg, none) center 25% / cover no-repeat;
    border: 1px solid var(--tblr-border-color);
  }
  .srch-best-person { background: linear-gradient(120deg, rgba(var(--tblr-primary-rgb), .35), rgba(10,12,18,.9)); }
  .srch-best::before { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,12,18,.94) 0%, rgba(10,12,18,.82) 45%, rgba(10,12,18,.45) 100%); }
  .srch-best-inner { position: relative; display: flex; gap: 1.25rem; padding: 1.25rem; color: #fff; }
  .srch-best-poster { width: 140px; flex: 0 0 140px; aspect-ratio: 2/3; object-fit: cover; border-radius: .6rem; box-shadow: 0 10px 30px rgba(0,0,0,.45); }
  .srch-best-body { min-width: 0; display: flex; flex-direction: column; gap: .35rem; }
  .srch-best-kicker { font-size: .7rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: rgba(255,255,255,.65); }
  .srch-best-title { margin: 0; font-size: 1.6rem; font-weight: 700; line-height: 1.15; color: #fff; }
  .srch-best-orig { font-size: .85rem; color: rgba(255,255,255,.6); font-style: italic; }
  .srch-best-meta { font-size: .85rem; color: rgba(255,255,255,.8); display: flex; align-items: center; gap: .2rem; flex-wrap: wrap; }
  .srch-best-genres { display: flex; flex-wrap: wrap; gap: .35rem; }
  .srch-genre { font-size: .72rem; padding: .15rem .55rem; border-radius: 999px; background: rgba(255,255,255,.12); color: rgba(255,255,255,.9); }
  .srch-best-overview { margin: .25rem 0 0; font-size: .88rem; line-height: 1.5; color: rgba(255,255,255,.85); max-width: 62ch; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .srch-best-actions { display: flex; align-items: center; gap: .5rem; margin-top: .6rem; }
  .srch-best-wl { position: static; width: 32px; height: 32px; border-radius: 50%; background: rgba(0,0,0,.35); border: 1px solid rgba(255,255,255,.2); display: inline-flex; align-items: center; justify-content: center; }
  .srch-best-wl svg { width: 16px; height: 16px; }
  .srch-people { display: flex; gap: .6rem; overflow-x: auto; padding-bottom: .25rem; }
  .srch-person {
    display: flex; align-items: center; gap: .65rem; flex: 0 0 auto; max-width: 280px;
    padding: .45rem .8rem .45rem .45rem; border-radius: 999px;
    background: var(--tblr-bg-surface); border: 1px solid var(--tblr-border-color);
    color: inherit; text-align: left; cursor: pointer; transition: border-color .15s, background .15s;
  }
  .srch-person:hover { border-color: var(--tblr-primary); background: rgba(var(--tblr-primary-rgb), .06); }
  .srch-person img, .srch-person-initials { width: 40px; height: 40px; flex: 0 0 40px; border-radius: 50%; object-fit: cover; }
  .srch-person-initials { display: inline-flex; align-items: center; justify-content: center; background: rgba(var(--tblr-primary-rgb), .15); color: var(--tblr-primary); font-weight: 600; font-size: .8rem; }
  .srch-person-text { min-width: 0; display: flex; flex-direction: column; }
  .srch-person-name { font-weight: 600; font-size: .85rem; }
  .srch-person-sub { font-size: .72rem; color: var(--tblr-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .srch-person-head { display: flex; gap: 1rem; align-items: flex-start; margin-bottom: 1rem; }
  .srch-person-head img { width: 110px; flex: 0 0 110px; aspect-ratio: 2/3; object-fit: cover; border-radius: .6rem; }
  .srch-person-head .srch-best-title, .srch-person-head .srch-best-kicker { color: inherit; }
  .srch-person-head .srch-best-kicker { color: var(--tblr-secondary); }
  .srch-person-head .srch-best-overview { color: var(--tblr-secondary); margin-bottom: .6rem; }
  .srch-grid { grid-template-columns: repeat(auto-fill, minmax(165px, 1fr)) !important; gap: 1rem !important; }
  @media (max-width: 640px) {
    .srch-best-inner { flex-direction: column; }
    .srch-best-poster { width: 110px; flex-basis: auto; }
    .srch-best-title { font-size: 1.3rem; }
    .srch-select { flex: 1 1 45%; }
  }

  .tmdb-search-bar { margin-bottom: 1rem; }

  /* ── Hero trending (header immersif, format 2-col) ── */
  .tmdb-hero-row .tmdb-hero { margin-bottom: 0; height: 100%; }
  .tmdb-hero {
    position: relative; border-radius: .5rem; overflow: hidden;
    min-height: 220px;
    border: 1px solid var(--tblr-border-color);
    background: #18181b;
    color: #fff; cursor: pointer;
    transition: transform .15s, box-shadow .15s;
  }
  .tmdb-hero:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.4); }
  .tmdb-hero-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center 20%;
    filter: brightness(0.45);
  }
  .tmdb-hero-bg::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(24,24,27,.95) 0%, rgba(24,24,27,.6) 50%, rgba(24,24,27,.2) 100%);
  }
  .tmdb-hero-content {
    position: relative; z-index: 1; padding: 1.25rem 1.5rem;
    display: flex; flex-direction: column; justify-content: flex-end;
    min-height: 220px;
  }
  .tmdb-hero-label {
    text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.65rem;
    color: var(--tblr-primary); font-weight: 700; margin-bottom: 0.35rem;
  }
  .tmdb-hero-title { font-size: 1.4rem; font-weight: 700; margin: 0 0 0.3rem; line-height: 1.15; }
  .tmdb-hero-meta { display: flex; flex-wrap: wrap; gap: 0.4rem 0.6rem; align-items: center; margin-bottom: 0.5rem; font-size: 0.75rem; opacity: 0.9; }
  .tmdb-hero-overview {
    font-size: 0.8rem; line-height: 1.4; opacity: 0.9;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden; margin-bottom: 0.7rem;
  }
  .tmdb-hero-actions { display: flex; gap: 0.4rem; flex-wrap: wrap; }

</style>

<div class="page-body">
  <div class="container-xl">

    {% if error %}
      {% include 'error/_service_banner.html.twig' with {
        service: 'TMDb',
        configured_url: service_url,
        reason: 'unreachable'
      } %}
    {% endif %}

    {% if not error %}

    {# Search: one query box + inline filters. Results replace the home
       content (hero banners, recommendations, rows) while a search is active. #}
    <div class="srch" data-srch>
      <div class="srch-bar">
        {{ ico.icon('search', 'srch-ico', 20) }}
        <input id="tmdb-search" type="search" class="srch-input"
               placeholder="{{ 'decouverte.srch.placeholder'|trans }}"
               aria-label="{{ 'decouverte.srch.placeholder'|trans }}" autocomplete="off">
        <kbd class="srch-kbd d-none d-md-inline" title="{{ 'decouverte.srch.shortcut'|trans }}">/</kbd>
      </div>
      <div class="srch-filters">
        <div class="srch-seg" role="group" aria-label="{{ 'decouverte.filters.type'|trans }}">
          <button type="button" class="is-active" data-srch-type="all">{{ 'decouverte.filters.all'|trans }}</button>
          <button type="button" data-srch-type="movie">{{ 'decouverte.filters.movies'|trans }}</button>
          <button type="button" data-srch-type="tv">{{ 'decouverte.filters.series'|trans }}</button>
        </div>
        <select id="srch-genre" class="form-select form-select-sm srch-select" aria-label="{{ 'decouverte.filters.genre'|trans }}">
          <option value="">{{ 'decouverte.srch.all_genres'|trans }}</option>
        </select>
        <select id="srch-vote" class="form-select form-select-sm srch-select" aria-label="{{ 'decouverte.srch.rating'|trans }}">
          <option value="0">{{ 'decouverte.srch.any_rating'|trans }}</option>
          <option value="6">★ 6+</option>
          <option value="7">★ 7+</option>
          <option value="8">★ 8+</option>
        </select>
        <select id="srch-sort" class="form-select form-select-sm srch-select" aria-label="{{ 'decouverte.filters.sort'|trans }}">
          <option value="relevance">{{ 'decouverte.srch.sort.relevance'|trans }}</option>
          <option value="popularity">{{ 'decouverte.srch.sort.popularity'|trans }}</option>
          <option value="vote">{{ 'decouverte.srch.sort.vote'|trans }}</option>
          <option value="newest">{{ 'decouverte.srch.sort.newest'|trans }}</option>
        </select>
        <label class="srch-check"><input type="checkbox" id="srch-hide-owned"> {{ 'decouverte.srch.hide_owned'|trans }}</label>
        <button type="button" class="srch-reset" id="srch-reset" hidden>{{ 'decouverte.filters.reset'|trans }}</button>
        <span class="flex-fill"></span>
        <a href="{{ path('tmdb_watchlist') }}" class="srch-btn" id="tmdb-watchlist-link">
          {{ ico.icon('star-filled', '', 14) }} {{ 'decouverte.actions.watchlist'|trans }}
          <span class="tmdb-filter-badge" id="tmdb-wl-count" style="display:none;">0</span>
        </a>
        <a href="{{ path('tmdb_explorer') }}" class="srch-btn">{{ ico.icon('world', '', 14) }} {{ 'decouverte.actions.explorer'|trans }}</a>
      </div>
    </div>

    <div id="srch-results" class="mb-4" hidden>
      <div class="srch-correction" id="srch-correction" hidden></div>
      <div class="srch-status" id="srch-status" aria-live="polite"></div>
      <div id="srch-person-head" hidden></div>
      <div id="srch-best"></div>
      <div id="srch-people-wrap" hidden>
        <div class="srch-label">{{ 'decouverte.srch.people'|trans }}</div>
        <div class="srch-people" id="srch-people"></div>
      </div>
      <div class="srch-label" id="srch-grid-label" hidden></div>
      <div class="tmdb-results-grid srch-grid" id="tmdb-search-grid"></div>
      <div class="text-center mt-3">
        <button type="button" class="btn btn-outline-secondary" id="srch-more" hidden>{{ 'decouverte.srch.more'|trans }}</button>
      </div>
    </div>

    <div id="srch-home">

    {% if heroMovie or heroTv %}
      <div class="row g-3 mb-3 tmdb-hero-row">
        {% if heroMovie %}
          <div class="col-lg-6">
            {{ _self.hero(heroMovie, 'decouverte.hero.movie'|trans) }}
          </div>
        {% endif %}
        {% if heroTv %}
          <div class="col-lg-6">
            {{ _self.hero(heroTv, 'decouverte.hero.tv'|trans) }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {# Recommendations section based on library (loaded via AJAX) — All/Movies/TV Shows filter #}
    <div class="tmdb-section" data-section="my-recs" id="tmdb-my-recs" style="display:none;">
      <div class="tmdb-section-header">
        <h3>
          {{ 'decouverte.section.my_recs.title'|trans }}
          <span class="count">· {{ 'decouverte.section.my_recs.subtitle'|trans }} <span id="tmdb-my-recs-count"></span></span>
        </h3>
        <div class="d-flex align-items-center gap-2">
          <div class="btn-group btn-group-sm" role="group">
            <input type="radio" class="btn-check" name="myrecs-filter" id="myrecs-all" value="all" checked>
            <label class="btn btn-outline-secondary py-0 px-2" for="myrecs-all" style="font-size:.7rem;">{{ 'decouverte.filters.all'|trans }}</label>
            <input type="radio" class="btn-check" name="myrecs-filter" id="myrecs-movies" value="movie">
            <label class="btn btn-outline-secondary py-0 px-2" for="myrecs-movies" style="font-size:.7rem;">{{ 'decouverte.filters.movies'|trans }}</label>
            <input type="radio" class="btn-check" name="myrecs-filter" id="myrecs-tv" value="tv">
            <label class="btn btn-outline-secondary py-0 px-2" for="myrecs-tv" style="font-size:.7rem;">{{ 'decouverte.filters.series'|trans }}</label>
          </div>
          <div class="tmdb-section-actions">
            <button type="button" class="tmdb-scroll-btn" data-scroll="left" aria-label="{{ 'decouverte.scroll.prev'|trans }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6l6 6"/></svg>
            </button>
            <button type="button" class="tmdb-scroll-btn" data-scroll="right" aria-label="{{ 'decouverte.scroll.next'|trans }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6l-6 6"/></svg>
            </button>
          </div>
        </div>
      </div>
      <div class="tmdb-row" id="tmdb-my-recs-row">
        <div class="text-secondary py-3 px-2">
          <span class="spinner-border spinner-border-sm me-2"></span>{{ 'decouverte.section.my_recs.loading'|trans }}
        </div>
      </div>
    </div>

    {{ _self.section('decouverte.section.trending'|trans, trending, 'trending') }}
    {{ _self.section('decouverte.section.popular_movies'|trans, popMovies, 'popular-movies') }}
    {{ _self.section('decouverte.section.popular_tv'|trans, popTv, 'popular-tv') }}
    {{ _self.section('decouverte.section.upcoming'|trans, upcoming, 'upcoming') }}
    {{ _self.section('decouverte.section.on_air'|trans, onAir, 'on-air') }}
    {{ _self.section('decouverte.section.top_movies'|trans, topMovies, 'top-movies') }}
    {{ _self.section('decouverte.section.top_tv'|trans, topTv, 'top-tv') }}
    {# Recently viewed — discreet, at the bottom of the page #}
    <div id="tmdb-recent" style="display:none; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--tblr-border-color);">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <span style="font-size:.8rem; color:var(--tblr-muted); font-weight:500;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px; margin-right:4px;"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          {{ 'decouverte.recent.title'|trans }}
        </span>
        <button type="button" class="btn btn-ghost-secondary btn-sm py-0 px-1" id="tmdb-recent-clear" style="font-size:.65rem;" title="{{ 'decouverte.recent.clear_title'|trans }}">{{ 'decouverte.recent.clear'|trans }}</button>
      </div>
      <div class="tmdb-row" id="tmdb-recent-row" style="gap:.5rem;"></div>
    </div>
    </div>{# /#srch-home #}

  </div>
</div>


{% endif %} {# /if not error #}

{# ── Hero macro (movie or series) ─────────────────────────────────────────────── #}
{% macro hero(item, label) %}
  <div class="tmdb-hero" data-tmdb-id="{{ item.id }}" data-tmdb-type="{{ item.type }}">
    {% if item.backdrop %}
      <div class="tmdb-hero-bg" style="background-image:url('{{ item.backdrop }}');"></div>
    {% endif %}
    <div class="tmdb-hero-content">
      <div class="tmdb-hero-label">{{ label }}</div>
      <h2 class="tmdb-hero-title">{{ item.title }}</h2>
      <div class="tmdb-hero-meta">
        {% if item.year %}<span>{{ item.year }}</span>{% endif %}
        {% if item.vote %}<span>{{ ico.icon('star-filled', '', 14) }} {{ item.vote }}/10</span>{% endif %}
        {% if item.in_library %}
          {# v1.1.0 — match the badge colour + label to the actual
             library status (downloaded / missing / announced / inCinemas
             / unmonitored), same scheme as the trending cards below.
             Falls back to a plain green "in library" when no status is
             attached (defensive — shouldn't happen post-refactor). #}
          {% set _heroStatusColors = {'downloaded':'#22c55e','missing':'#f59e0b','announced':'#6366f1','inCinemas':'#6366f1','partial':'#3b82f6','unmonitored':'#6b7280'} %}
          {% set _heroStatusKey = item.lib_status ? 'decouverte.modal.status.' ~ item.lib_status : null %}
          <span class="badge" style="background:{{ _heroStatusColors[item.lib_status] ?? '#22c55e' }}; color:#fff;">
            {{ _heroStatusKey ? _heroStatusKey|trans : 'decouverte.badge.in_library'|trans }}
          </span>
        {% endif %}
      </div>
      {% if item.overview %}
        <div class="tmdb-hero-overview">{{ item.overview }}</div>
      {% endif %}
      <div class="tmdb-hero-actions">
        {% if not item.in_library %}
          <button class="btn btn-primary btn-sm tmdb-add-btn"
                  data-tmdb-id="{{ item.id }}"
                  data-tmdb-type="{{ item.type }}"
                  data-tmdb-title="{{ item.title }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M12 5l0 14"/><path d="M5 12l14 0"/></svg>
            {{ 'decouverte.action.add'|trans }}
          </button>
        {% endif %}
        <button type="button" class="btn btn-outline-light btn-sm tmdb-hero-details-btn"
                data-tmdb-id="{{ item.id }}" data-tmdb-type="{{ item.type }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          {{ 'decouverte.action.details'|trans }}
        </button>
      </div>
    </div>
  </div>
{% endmacro %}

{# ── Macro for a horizontally-scrollable section ────────────────────────────── #}
{% macro section(title, items, slug) %}
  <div class="tmdb-section" data-section="{{ slug }}">
    <div class="tmdb-section-header">
      <h3>
        {{ title }}
        <span class="count">· {{ items|length }}</span>
      </h3>
      <div class="tmdb-section-actions">
        <button type="button" class="tmdb-scroll-btn" data-scroll="left" aria-label="{{ 'decouverte.scroll.prev'|trans }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M15 6l-6 6l6 6"/></svg>
        </button>
        <button type="button" class="tmdb-scroll-btn" data-scroll="right" aria-label="{{ 'decouverte.scroll.next'|trans }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l6 6l-6 6"/></svg>
        </button>
      </div>
    </div>
    <div class="tmdb-row">
      {% for item in items %}
        {{ _self.card(item) }}
      {% else %}
        <div class="text-secondary py-4 px-2">{{ 'decouverte.search.no_results'|trans }}</div>
      {% endfor %}
    </div>
  </div>
{% endmacro %}

{# ── Macro for a TMDb card (mimics .media-card layout from Movies) ────────── #}
{% macro card(item) %}
  {% set voteClass = 'bad' %}
  {% if item.vote >= 7 %}{% set voteClass = 'good' %}
  {% elseif item.vote >= 5 %}{% set voteClass = 'mid' %}
  {% endif %}
  <div class="media-card"
       data-tmdb-id="{{ item.id }}"
       data-tmdb-type="{{ item.type }}"
       data-tmdb-title="{{ item.title }}"
       data-tmdb-vote="{{ item.vote }}"
       data-tmdb-year="{{ item.year }}"
       data-release="{{ item.release }}"
       >
    {% if item.poster %}
      <img src="{{ item.poster }}" alt="{{ item.title }}" loading="lazy" decoding="async">
    {% else %}
      <div class="no-poster">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 4v16l13 -8z"/></svg>
      </div>
    {% endif %}
    <span class="quality-badge {{ item.type }}">{{ item.type == 'movie' ? 'decouverte.modal.type_film'|trans : 'decouverte.modal.type_series'|trans }}</span>
    {% if item.in_library %}
      {% set statusColors = {'downloaded':'#22c55e','missing':'#f59e0b','announced':'#6366f1','inCinemas':'#6366f1','partial':'#3b82f6','unmonitored':'#6b7280'} %}
      {% set statusShortKey = 'decouverte.card.status_short.' ~ (item.lib_status ?: 'default') %}
      <span class="lib-badge" style="background:{{ statusColors[item.lib_status] ?? '#22c55e' }};">{{ statusShortKey|trans }}</span>
    {% endif %}
    <button type="button" class="wl-star" data-tmdb-id="{{ item.id }}" data-tmdb-type="{{ item.type }}" title="{{ 'decouverte.modal.watchlist'|trans }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.6-6.2 4.6 2.4-7.4-6.2-4.5h7.6z"/></svg>
    </button>
    {% if item.vote %}
      <span class="vote-badge {{ voteClass }}">{{ ico.icon('star-filled', '', 14) }} {{ item.vote }}</span>
    {% endif %}
    <div class="card-overlay">
      <div class="card-title-text" title="{{ item.title }}">{{ item.title }}</div>
      <div class="card-year">{{ item.year ?: '' }}</div>
    </div>
    <div class="hover-info">
      <div class="h-title">{{ item.title }}</div>
      <div class="h-year">{{ item.year ?: '' }}{% if item.vote %} · {{ ico.icon('star-filled', '', 14) }} {{ item.vote }}{% endif %}</div>
      <div class="h-actions">
        {% if not item.in_library %}
          <button type="button" class="btn btn-primary btn-sm tmdb-add-btn"
                  data-tmdb-id="{{ item.id }}"
                  data-tmdb-type="{{ item.type }}"
                  data-tmdb-title="{{ item.title }}">{{ 'decouverte.action.add'|trans }}</button>
        {% else %}
          {% set statusColors = {'downloaded':'#22c55e','missing':'#f59e0b','announced':'#6366f1','inCinemas':'#6366f1','partial':'#3b82f6','unmonitored':'#6b7280'} %}
          {% set statusKey = 'decouverte.modal.status.' ~ (item.lib_status ?: 'downloaded') %}
          {% set statusLabel = item.lib_status ? statusKey|trans : 'decouverte.card.in_library_short'|trans %}
          {% set basePath = app.request.getBasePath() %}
          <a href="{{ (item.type == 'movie' ? basePath ~ '/medias/' ~ current_slug('radarr') ~ '/films' : basePath ~ '/medias/' ~ current_slug('sonarr') ~ '/series') ~ '?open=' ~ item.lib_id }}" class="btn btn-sm" style="background:{{ statusColors[item.lib_status] ?? '#22c55e' }};color:#fff;">{{ statusLabel }}</a>
        {% endif %}
      </div>
    </div>
  </div>
{% endmacro %}

<script>
(function() {
  // Turbo re-runs this script on every visit to the page. A listener bound
  // on `document` would pile up (one more copy per visit: a card click then
  // opens the detail modal N times) and keep pointing at the previous
  // visit's DOM. bindDoc() swaps the previous copy for the new one.
  function bindDoc(type, name, fn) {
    var slot = '_prismarrSearchDoc_' + name;
    if (window[slot]) document.removeEventListener(type, window[slot]);
    window[slot] = fn;
    document.addEventListener(type, fn);
  }
  var BASE = window.BASE_PATH;
  var RECENT_KEY = 'prismarr_tmdb_recent';
  var RECENT_MAX = 10;
  var recentBlock = document.getElementById('tmdb-recent');
  var recentRow   = document.getElementById('tmdb-recent-row');

  function getRecent() {
    try { return JSON.parse(localStorage.getItem(RECENT_KEY)) || []; } catch(e) { return []; }
  }

  function saveRecent(list) {
    localStorage.setItem(RECENT_KEY, JSON.stringify(list));
  }

  window.__prismarrPushRecent = pushRecent;
  function pushRecent(item) {
    var list = getRecent().filter(function(r) { return !(r.id === item.id && r.type === item.type); });
    list.unshift(item);
    if (list.length > RECENT_MAX) list = list.slice(0, RECENT_MAX);
    saveRecent(list);
    renderRecent();
  }

  function renderRecent() {
    var list = getRecent();
    if (!list.length) { recentBlock.style.display = 'none'; return; }
    recentBlock.style.display = '';
    recentRow.innerHTML = list.map(renderCardHTML).join('');
    if (window._prismarrWatchlistSync) window._prismarrWatchlistSync();
  }

  renderRecent();

  var clearBtn = document.getElementById('tmdb-recent-clear');
  if (clearBtn) {
    clearBtn.addEventListener('click', function() {
      localStorage.removeItem(RECENT_KEY);
      renderRecent();
    });
  }

  // ── J-X countdown on Twig cards (client-side)
  function applyCountdowns() {
    document.querySelectorAll('.media-card[data-release]').forEach(function(card) {
      var rel = card.dataset.release;
      if (!rel) return;
      if (card.querySelector('.countdown-badge')) return; // already added
      var diff = Math.ceil((new Date(rel) - new Date()) / 86400000);
      if (diff > 0 && diff <= 365) {
        var badge = document.createElement('span');
        badge.className = 'countdown-badge';
        badge.textContent = 'J-' + diff;
        card.appendChild(badge);
      }
    });
  }
  applyCountdowns();

  // ── Add button → resolve + open existing quick-add modal (base.html.twig)
  // The .tmdb-add-btn listener used to live here. It now lives in
  // decouverte/_detail_modal.html.twig so the Lists and Watchlists tabs get
  // the same behaviour, and so Add creates a Seerr request rather than
  // pushing straight to Radarr/Sonarr. Two listeners would add twice.

  // ── Click on card → Prismarr detail modal (Turbo-safe manual open)
  // ── Search page: query + filters → /decouverte/recherche ──────────
  var srchInput      = document.getElementById('tmdb-search');
  var srchResults    = document.getElementById('srch-results');
  var srchHome       = document.getElementById('srch-home');
  var srchStatus     = document.getElementById('srch-status');
  var srchCorrection = document.getElementById('srch-correction');
  var srchBest       = document.getElementById('srch-best');
  var srchPeopleWrap = document.getElementById('srch-people-wrap');
  var srchPeople     = document.getElementById('srch-people');
  var srchPersonHead = document.getElementById('srch-person-head');
  var srchGridLabel  = document.getElementById('srch-grid-label');
  var srchGrid       = document.getElementById('tmdb-search-grid');
  var srchMore       = document.getElementById('srch-more');
  var srchReset      = document.getElementById('srch-reset');
  var srchGenre      = document.getElementById('srch-genre');
  var srchVote       = document.getElementById('srch-vote');
  var srchSort       = document.getElementById('srch-sort');
  var srchHideOwned  = document.getElementById('srch-hide-owned');
  var SRCH_I18N = {
    searching:   {{ 'decouverte.search.searching'|trans|json_encode|raw }},
    noResults:   {{ 'decouverte.search.no_results'|trans|json_encode|raw }},
    error:       {{ 'decouverte.search.search_error'|trans|json_encode|raw }},
    count:       {{ 'decouverte.srch.count'|trans|json_encode|raw }},
    browse:      {{ 'decouverte.srch.browse'|trans|json_encode|raw }},
    best:        {{ 'decouverte.srch.best'|trans|json_encode|raw }},
    others:      {{ 'decouverte.srch.others'|trans|json_encode|raw }},
    details:     {{ 'decouverte.action.details'|trans|json_encode|raw }},
    add:         {{ 'decouverte.action.add'|trans|json_encode|raw }},
    inLibrary:   {{ 'decouverte.card.in_library_short'|trans|json_encode|raw }},
    filmography: {{ 'decouverte.srch.filmography'|trans|json_encode|raw }},
    back:        {{ 'decouverte.srch.back'|trans|json_encode|raw }},
    allGenres:   {{ 'decouverte.srch.all_genres'|trans|json_encode|raw }},
    didYouMean:  {{ 'decouverte.srch.did_you_mean'|trans|json_encode|raw }},
    showingFor:  {{ 'decouverte.srch.showing_for'|trans|json_encode|raw }},
    searchInstead: {{ 'decouverte.srch.search_instead'|trans|json_encode|raw }},
    personKicker:  {{ 'decouverte.srch.person_kicker'|trans|json_encode|raw }},
    seeFilmography: {{ 'decouverte.srch.see_filmography'|trans|json_encode|raw }},
    film:        TMDB_I18N.type_film,
    series:      TMDB_I18N.type_series
  };
  var srch = { type: 'all', page: 1, totalPages: 1, abort: null, timer: null, exact: false };
  var srchGenresCache = { movie: null, tv: null };

  function srchFiltersActive() {
    return srch.type !== 'all' || !!srchGenre.value
      || parseFloat(srchVote.value) > 0 || srchSort.value !== 'relevance' || srchHideOwned.checked;
  }

  function srchShowHome(show) {
    srchHome.hidden = !show;
    srchResults.hidden = show;
    if (show) srchCorrection.hidden = true;
  }

  function srchParams(page) {
    var p = new URLSearchParams({ type: srch.type, sort: srchSort.value, page: String(page || 1) });
    var q = srchInput.value.trim();
    if (q) p.set('q', q);
    if (q && srch.exact) p.set('exact', '1');
    if (srchGenre.value) p.set('genre', srchGenre.value);
    if (parseFloat(srchVote.value) > 0) p.set('vote_min', srchVote.value);
    if (srchHideOwned.checked) p.set('hide_owned', '1');
    return p;
  }

  function srchBestHTML(b) {
    var typeLabel = b.type === 'movie' ? SRCH_I18N.film : SRCH_I18N.series;
    var meta = [escHtml(String(b.year || '')), typeLabel];
    if (b.vote) meta.push({{ ico.icon('star-filled', '', 13)|json_encode|raw }} + ' ' + escHtml(String(b.vote)));
    var genres = (b.genres || []).map(function (g) { return '<span class="srch-genre">' + escHtml(g) + '</span>'; }).join('');
    var poster = b.poster_hi || b.poster;
    var action = b.in_library
      ? '<a class="btn btn-success btn-sm" href="' + BASE + (b.type === 'movie' ? '/medias/' + DEFAULT_RADARR_SLUG + '/films' : '/medias/' + DEFAULT_SONARR_SLUG + '/series') + '?open=' + encodeURIComponent(b.lib_id || '') + '">' + escHtml(SRCH_I18N.inLibrary) + '</a>'
      : '<button type="button" class="btn btn-primary btn-sm tmdb-add-btn" data-tmdb-id="' + b.id + '" data-tmdb-type="' + b.type + '" data-tmdb-title="' + escHtml(b.title || '') + '">' + escHtml(SRCH_I18N.add) + '</button>';
    var wlOn = window._prismarrWatchlist && window._prismarrWatchlist[b.type + '_' + b.id];
    return '<div class="srch-best"' + (b.backdrop ? ' style="--srch-bg:url(\'' + encodeURI(b.backdrop) + '\')"' : '') + '>'
      + '<div class="srch-best-inner">'
      + (poster ? '<img class="srch-best-poster" src="' + encodeURI(poster) + '" alt="" loading="lazy">' : '')
      + '<div class="srch-best-body">'
      + '<div class="srch-best-kicker">' + escHtml(SRCH_I18N.best) + '</div>'
      + '<h2 class="srch-best-title">' + escHtml(b.title || '') + '</h2>'
      + (b.original_title && b.original_title !== b.title ? '<div class="srch-best-orig">' + escHtml(b.original_title) + '</div>' : '')
      + '<div class="srch-best-meta">' + meta.join(' · ') + '</div>'
      + (genres ? '<div class="srch-best-genres">' + genres + '</div>' : '')
      + (b.overview ? '<p class="srch-best-overview">' + escHtml(b.overview) + '</p>' : '')
      + '<div class="srch-best-actions">' + action
      + '<button type="button" class="btn btn-outline-light btn-sm tmdb-hero-details-btn" data-tmdb-type="' + b.type + '" data-tmdb-id="' + b.id + '">' + escHtml(SRCH_I18N.details) + '</button>'
      + '<button type="button" class="wl-star srch-best-wl' + (wlOn ? ' in-wl' : '') + '" data-tmdb-id="' + b.id + '" data-tmdb-type="' + b.type + '" title="Watchlist"><svg viewBox="0 0 24 24" fill="' + (wlOn ? '#f59e0b' : 'none') + '" stroke="#f59e0b" stroke-width="2"><path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.6-6.2 4.6 2.4-7.4-6.2-4.5h7.6z"/></svg></button>'
      + '</div></div></div></div>';
  }

  function srchBestPersonHTML(p) {
    var sub = [p.known].concat(p.titles || []).filter(Boolean).map(escHtml).join(' · ');
    return '<div class="srch-best srch-best-person">'
      + '<div class="srch-best-inner">'
      + (p.profile ? '<img class="srch-best-poster" src="' + encodeURI(p.profile) + '" alt="" loading="lazy">' : '')
      + '<div class="srch-best-body">'
      + '<div class="srch-best-kicker">' + escHtml(SRCH_I18N.personKicker) + '</div>'
      + '<h2 class="srch-best-title">' + escHtml(p.name || '') + '</h2>'
      + (sub ? '<div class="srch-best-meta">' + sub + '</div>' : '')
      + '<div class="srch-best-actions"><button type="button" class="btn btn-primary btn-sm" data-srch-person="' + p.id + '" data-srch-person-name="' + escHtml(p.name || '') + '">' + escHtml(SRCH_I18N.seeFilmography) + '</button></div>'
      + '</div></div></div>';
  }

  function srchPeopleHTML(list) {
    return list.map(function (p) {
      var avatar = p.profile
        ? '<img src="' + encodeURI(p.profile) + '" alt="" loading="lazy">'
        : '<span class="srch-person-initials">' + escHtml((p.name || '?').split(' ').map(function (w) { return w.charAt(0); }).join('').slice(0, 2)) + '</span>';
      var sub = [p.known].concat(p.titles || []).filter(Boolean).map(escHtml).join(' · ');
      return '<button type="button" class="srch-person" data-srch-person="' + p.id + '" data-srch-person-name="' + escHtml(p.name || '') + '">'
        + avatar + '<span class="srch-person-text"><span class="srch-person-name">' + escHtml(p.name || '') + '</span>'
        + '<span class="srch-person-sub">' + sub + '</span></span></button>';
    }).join('');
  }

  function srchCorrectionHTML(d) {
    if (d.corrected_from && d.corrected_to) {
      return escHtml(SRCH_I18N.showingFor).replace('__S__', '<strong>' + escHtml(d.corrected_to) + '</strong>')
        + ' <button type="button" class="srch-inline-link is-quiet" data-srch-exact="' + escHtml(d.corrected_from) + '">'
        + escHtml(SRCH_I18N.searchInstead.replace('__Q__', d.corrected_from)) + '</button>';
    }
    if (d.suggestion) {
      return escHtml(SRCH_I18N.didYouMean).replace('__S__', '<button type="button" class="srch-inline-link" data-srch-suggest="' + escHtml(d.suggestion) + '">' + escHtml(d.suggestion) + '</button>');
    }
    return '';
  }

  function srchRender(d, append) {
    var results = d.results || [];
    srchPersonHead.hidden = true;
    if (!append) {
      var corr = srchCorrectionHTML(d);
      srchCorrection.innerHTML = corr;
      srchCorrection.hidden = corr === '';
    }
    if (!append) {
      srchBest.innerHTML = d.best_person ? srchBestPersonHTML(d.best_person) : (d.best ? srchBestHTML(d.best) : '');
      srchPeople.innerHTML = srchPeopleHTML(d.people || []);
      srchPeopleWrap.hidden = !(d.people && d.people.length);
      srchGridLabel.hidden = !((d.best || d.best_person) && results.length);
      srchGridLabel.textContent = SRCH_I18N.others;
      srchGrid.innerHTML = results.map(renderCardHTML).join('');
    } else {
      srchGrid.insertAdjacentHTML('beforeend', results.map(renderCardHTML).join(''));
    }
    var total = d.mode === 'search' ? (d.total || 0) : srchGrid.children.length;
    srchStatus.textContent = total === 0
      ? SRCH_I18N.noResults
      : (d.mode === 'search' ? SRCH_I18N.count.replace('__N__', total) : SRCH_I18N.browse);
    srch.page = d.page || 1;
    srch.totalPages = d.total_pages || 1;
    srchMore.hidden = !(d.mode === 'discover' && srch.page < srch.totalPages);
    if (window._prismarrWatchlistSync) window._prismarrWatchlistSync();
  }

  function srchRun(append) {
    var q = srchInput.value.trim();
    srchReset.hidden = !srchFiltersActive();
    if (q.length < 2 && !srchFiltersActive()) {
      if (srch.abort) { try { srch.abort.abort(); } catch (e) {} }
      srchShowHome(true);
      return;
    }
    srchShowHome(false);
    var page = append ? srch.page + 1 : 1;
    if (!append) {
      srchStatus.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>' + escHtml(SRCH_I18N.searching);
    }
    if (srch.abort) { try { srch.abort.abort(); } catch (e) {} }
    srch.abort = new AbortController();
    fetch(BASE + '/decouverte/recherche?' + srchParams(page).toString(), { signal: srch.abort.signal, credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d.mode === 'error') { srchStatus.textContent = SRCH_I18N.error; return; }
        srchRender(d, append);
      })
      .catch(function (e) { if (e && e.name !== 'AbortError') srchStatus.textContent = SRCH_I18N.error; });
  }

  function srchSchedule() {
    clearTimeout(srch.timer);
    srch.timer = setTimeout(function () { srchRun(false); }, 300);
  }

  function srchLoadGenres() {
    var types = srch.type === 'all' ? ['movie', 'tv'] : [srch.type];
    var pending = types.filter(function (t) { return !srchGenresCache[t]; });
    Promise.all(pending.map(function (t) {
      return fetch(BASE + '/decouverte/genres/' + t, { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) { srchGenresCache[t] = d.genres || []; });
    })).then(function () {
      var seen = {}, list = [];
      types.forEach(function (t) {
        (srchGenresCache[t] || []).forEach(function (g) { if (!seen[g.id]) { seen[g.id] = true; list.push(g); } });
      });
      list.sort(function (a, b) { return String(a.name).localeCompare(String(b.name)); });
      var current = srchGenre.value;
      srchGenre.innerHTML = '<option value="">' + escHtml(SRCH_I18N.allGenres) + '</option>'
        + list.map(function (g) { return '<option value="' + escHtml(String(g.id)) + '">' + escHtml(g.name) + '</option>'; }).join('');
      if (list.some(function (g) { return String(g.id) === current; })) srchGenre.value = current;
    }).catch(function () {});
  }

  function srchOpenPerson(id, name) {
    srchShowHome(false);
    srchCorrection.hidden = true;
    srchBest.innerHTML = '';
    srchPeopleWrap.hidden = true;
    srchGridLabel.hidden = true;
    srchMore.hidden = true;
    srchGrid.innerHTML = '';
    srchStatus.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>' + escHtml(SRCH_I18N.searching);
    fetch(BASE + '/decouverte/person/' + encodeURIComponent(id), { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d.error) { srchStatus.textContent = SRCH_I18N.error; return; }
        srchPersonHead.innerHTML = '<div class="srch-person-head">'
          + (d.profile ? '<img src="' + encodeURI(d.profile) + '" alt="">' : '')
          + '<div><div class="srch-best-kicker">' + escHtml(SRCH_I18N.filmography) + '</div><h2 class="srch-best-title">' + escHtml(d.name || name || '') + '</h2>'
          + (d.bio ? '<p class="srch-best-overview">' + escHtml(d.bio) + '</p>' : '')
          + '<button type="button" class="btn btn-outline-secondary btn-sm" data-srch-back>' + escHtml(SRCH_I18N.back) + '</button></div></div>';
        srchPersonHead.hidden = false;
        srchGrid.innerHTML = (d.results || []).map(renderCardHTML).join('');
        srchStatus.textContent = SRCH_I18N.count.replace('__N__', (d.results || []).length);
        if (window._prismarrWatchlistSync) window._prismarrWatchlistSync();
      })
      .catch(function () { srchStatus.textContent = SRCH_I18N.error; });
  }

  if (srchInput) {
    srchInput.addEventListener('input', function () { srch.exact = false; srchSchedule(); });
    srchInput.addEventListener('search', function () { srchRun(false); });
    [srchGenre, srchVote, srchSort, srchHideOwned].forEach(function (el) { el.addEventListener('change', function () { srchRun(false); }); });
    document.querySelectorAll('[data-srch-type]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        srch.type = btn.dataset.srchType;
        document.querySelectorAll('[data-srch-type]').forEach(function (b) { b.classList.toggle('is-active', b === btn); });
        srchLoadGenres();
        srchRun(false);
      });
    });
    srchGenre.addEventListener('focus', srchLoadGenres, { once: true });
    srchReset.addEventListener('click', function () {
      srch.type = 'all';
      document.querySelectorAll('[data-srch-type]').forEach(function (b) { b.classList.toggle('is-active', b.dataset.srchType === 'all'); });
      srchGenre.value = '';
      srchVote.value = '0'; srchSort.value = 'relevance'; srchHideOwned.checked = false;
      srchRun(false);
    });
    srchMore.addEventListener('click', function () { srchRun(true); });
    srchResults.addEventListener('click', function (e) {
      var person = e.target.closest('[data-srch-person]');
      if (person) { srchOpenPerson(person.dataset.srchPerson, person.dataset.srchPersonName); return; }
      if (e.target.closest('[data-srch-back]')) { srchRun(false); return; }
      var sugg = e.target.closest('[data-srch-suggest]');
      if (sugg) { srchInput.value = sugg.dataset.srchSuggest; srch.exact = false; srchRun(false); return; }
      var exact = e.target.closest('[data-srch-exact]');
      if (exact) { srchInput.value = exact.dataset.srchExact; srch.exact = true; srchRun(false); }
    });
    // "/" focuses the search box from anywhere on the page (not while typing).
    bindDoc('keydown', 'keydown8', function (e) {
      if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
      var t = e.target;
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
      e.preventDefault();
      srchInput.focus();
    });
  }

  // Hero "View details" button → opens Prismarr modal (not external TMDb)
  bindDoc('click', 'click9', function(e) {
    var btn = e.target.closest('.tmdb-hero-details-btn');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    loadDetail(btn.dataset.tmdbType, btn.dataset.tmdbId);
  });

  // "For you" filter: All / Movies / TV (3 distinct lists returned by the backend)
  var myRecsSets = { all: [], movie: [], tv: [] };
  var myRecsCountEl = document.getElementById('tmdb-my-recs-count');
  function renderMyRecs(typeFilter) {
    var list = myRecsSets[typeFilter] || [];
    myRecsRow.innerHTML = list.map(renderCardHTML).join('')
      || '<div class="text-secondary py-4 px-2">' + {{ 'decouverte.search.no_filter_item'|trans|json_encode|raw }} + '</div>';
    if (myRecsCountEl) myRecsCountEl.textContent = '(' + list.length + ')';
    if (window._prismarrWatchlistSync) window._prismarrWatchlistSync();
  }
  document.querySelectorAll('input[name="myrecs-filter"]').forEach(function(r) {
    r.addEventListener('change', function() { renderMyRecs(r.value); });
  });

  // ── Recommendations based on the library (AJAX load on page load)
  var myRecsBlock = document.getElementById('tmdb-my-recs');
  var myRecsRow = document.getElementById('tmdb-my-recs-row');
  fetch(BASE + '/decouverte/mes-recommandations', { credentials: 'same-origin' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.seeds === 0 || !d.results || !d.results.length) {
        myRecsBlock.style.display = 'none';
        return;
      }
      myRecsSets.all   = d.results || [];
      myRecsSets.movie = d.movies  || [];
      myRecsSets.tv    = d.tv      || [];
      renderMyRecs('all');
      myRecsBlock.style.display = '';
      if (window._prismarrWatchlistSync) window._prismarrWatchlistSync();
    })
    .catch(function() { myRecsBlock.style.display = 'none'; });

  // ── Watchlist ───────────────────────────────────────────
  window._prismarrWatchlist = {};

  // Load the watchlist index on startup
  function syncAllWlStars() {
    document.querySelectorAll('.wl-star[data-tmdb-id]').forEach(function(btn) {
      var key = btn.dataset.tmdbType + '_' + btn.dataset.tmdbId;
      var inWl = !!window._prismarrWatchlist[key];
      btn.classList.toggle('in-wl', inWl);
      btn.querySelector('svg').setAttribute('fill', inWl ? '#f59e0b' : 'none');
    });
    // Counter badge
    var count = Object.keys(window._prismarrWatchlist).length;
    var badge = document.getElementById('tmdb-wl-count');
    if (badge) {
      badge.textContent = count;
      badge.style.display = count > 0 ? '' : 'none';
    }
  }
  window._prismarrWatchlistSync = syncAllWlStars;

  fetch(BASE + '/decouverte/watchlist/status', { credentials: 'same-origin' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      window._prismarrWatchlist = d.index || {};
      syncAllWlStars();
    });

  // Toggle watchlist (click on card star or modal button)
  function syncWlUI(tmdbId, type, added) {
    document.querySelectorAll('.wl-star[data-tmdb-id="' + tmdbId + '"][data-tmdb-type="' + type + '"]').forEach(function(s) {
      s.classList.toggle('in-wl', added);
      s.querySelector('svg').setAttribute('fill', added ? '#f59e0b' : 'none');
    });
    var modalBtn = document.querySelector('.tmdb-wl-modal-btn[data-tmdb-id="' + tmdbId + '"]');
    if (modalBtn) {
      modalBtn.className = 'btn ' + (added ? 'btn-warning' : 'btn-outline-warning') + ' tmdb-wl-modal-btn';
      modalBtn.querySelector('svg').setAttribute('fill', added ? '#fff' : 'none');
      var textNode = modalBtn.childNodes[modalBtn.childNodes.length - 1];
      textNode.textContent = added ? 'Dans la watchlist' : 'Watchlist';
    }
    if (window._prismarrWatchlistSync) window._prismarrWatchlistSync();
  }

  function toggleWatchlist(tmdbId, type, title, posterPath, vote, year, btn) {
    var key = type + '_' + tmdbId;
    var wasIn = !!window._prismarrWatchlist[key];
    var willAdd = !wasIn;

    // Optimistic: immediate UI update
    if (willAdd) window._prismarrWatchlist[key] = true;
    else delete window._prismarrWatchlist[key];
    syncWlUI(tmdbId, type, willAdd);

    fetch(BASE + '/decouverte/watchlist/toggle', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        tmdb_id: parseInt(tmdbId),
        type: type,
        title: title,
        poster_path: posterPath || null,
        vote: vote ? parseFloat(vote) : null,
        year: year ? parseInt(year) : null
      })
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      // Confirm or correct the state
      var added = d.action === 'added';
      if (added) window._prismarrWatchlist[key] = true;
      else delete window._prismarrWatchlist[key];
      if (added !== willAdd) syncWlUI(tmdbId, type, added);
      if (window._prismarrToast) window._prismarrToast(added ? TMDB_I18N.wl_added : TMDB_I18N.wl_removed, added ? 'success' : 'info');
    })
    .catch(function() {
      // Rollback on network error
      if (wasIn) window._prismarrWatchlist[key] = true;
      else delete window._prismarrWatchlist[key];
      syncWlUI(tmdbId, type, wasIn);
      if (window._prismarrToast) window._prismarrToast(TMDB_I18N.network_error, 'danger');
    });
  }

  // Star click on cards (only .media-card, not .ex-card)
  bindDoc('click', 'click10', function(e) {
    var star = e.target.closest('.wl-star');
    if (!star) return;
    if (!star.closest('.media-card[data-tmdb-id]')) return;
    e.stopPropagation();
    e.preventDefault();
    var card = star.closest('.media-card[data-tmdb-id]');
    var posterImg = card ? card.querySelector('img') : null;
    var posterPath = '';
    if (posterImg && posterImg.src) {
      var match = posterImg.src.match(/\/t\/p\/\w+(\/.+)$/);
      if (match) posterPath = match[1];
    }
    toggleWatchlist(
      star.dataset.tmdbId,
      star.dataset.tmdbType,
      card ? card.dataset.tmdbTitle : '',
      posterPath,
      card ? (card.dataset.tmdbVote || '') : '',
      card ? (card.dataset.tmdbYear || '') : '',
      star
    );
  });

  // Clic bouton watchlist dans la modal
  bindDoc('click', 'click11', function(e) {
    var btn = e.target.closest('.tmdb-wl-modal-btn');
    if (!btn) return;
    e.stopPropagation();
    toggleWatchlist(
      btn.dataset.tmdbId,
      btn.dataset.tmdbType,
      btn.dataset.tmdbTitle,
      btn.dataset.posterPath,
      btn.dataset.vote,
      btn.dataset.year,
      btn
    );
  });

  // Si URL a ?detail=type/id, ouvrir la modal au chargement
  if (document.getElementById('tmdb-detail-modal')) {
    var urlParams = new URLSearchParams(window.location.search);
    var detailParam = urlParams.get('detail');
    if (detailParam) {
      var parts = detailParam.split('/');
      if (parts.length === 2) {
        setTimeout(function() { loadDetail(parts[0], parts[1]); }, 300);
      }
      // Nettoyer l'URL
      history.replaceState(null, '', window.location.pathname);
    }
  }
})();
</script>
</div>
